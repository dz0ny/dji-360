---
/**
 * Equirectangular sphere viewer.
 *
 * Photo Sphere Viewer pulls in three.js (~600 kB raw), so it is imported
 * dynamically and only once the container is actually near the viewport. Until
 * then the slot renders a flat 2:1 still, which is what a phone on a slow
 * connection should get anyway.
 *
 * `twoFingers` is the mobile-critical prop: inside a scrolling page it must be
 * true so a one-finger swipe scrolls past the panorama instead of trapping the
 * gesture. On the dedicated /view/ page it is false so a single finger looks
 * around.
 */
interface Props {
	/** Equirectangular image URL. Omit to boot the viewer later via `viewer.setPanorama`. */
	src?: string;
	caption?: string;
	/** Require two fingers to pan. True inside scrollable pages, false full-screen. */
	twoFingers?: boolean;
	/** Slow idle rotation until the first interaction. */
	autorotate?: boolean;
	/** Show the floating navbar. False for teaser spheres that link out to /view/. */
	controls?: boolean;
	/**
	 * Load the map plugin. Off by default — it is dead weight on a page whose
	 * panoramas have no coordinates, and the minimap image is stitched from OSM
	 * tiles at runtime, which is a network round trip the hero does not want.
	 */
	map?: boolean;
	/** Show the quality button, which cycles through the textures `pano:meta` names. */
	resolutions?: boolean;
	/**
	 * Open on a stereographic "little planet" and unroll into the sphere. A one-
	 * off flourish for the dedicated viewer; silently skipped for reduced-motion
	 * readers and whenever the URL already names a viewpoint.
	 */
	intro?: boolean;
	/**
	 * Keep the current view in the URL hash, so a copied link reopens looking at
	 * the same thing. Only for pages where the sphere IS the page.
	 */
	hash?: boolean;
	/** Load the markers plugin, which the peak labels need. */
	markers?: boolean;
	/**
	 * Add the summits button to the control pill. The button only dispatches
	 * `pano:peaks-toggle`; whoever owns the panel decides what that means, and
	 * tells the button whether it should be there at all with
	 * `pano:peaks-button`. The viewer knows nothing about mountains.
	 */
	peaks?: boolean;
	class?: string;
	id?: string;
}

const {
	src,
	caption = "",
	twoFingers = true,
	autorotate = false,
	controls = true,
	map = false,
	resolutions = false,
	intro = false,
	hash = false,
	markers = false,
	peaks = false,
	class: className = "",
	id,
} = Astro.props;
---

<div
  id={id}
  class:list={["pano relative isolate overflow-hidden bg-black", className]}
  data-pano
  data-src={src}
  data-caption={caption}
  data-two-fingers={String(twoFingers)}
  data-autorotate={String(autorotate)}
  data-controls={String(controls)}
  data-map={String(map)}
  data-resolutions={String(resolutions)}
  data-intro={String(intro)}
  data-hash={String(hash)}
  data-markers={String(markers)}
  data-peaks={String(peaks)}
>
  {/* Poster / fallback: whatever the caller slots in, usually a flat <Picture>. */}
  <div class="pano-poster absolute inset-0 transition-opacity duration-700" data-pano-poster>
    <slot />
  </div>

  <div class="pano-stage absolute inset-0 opacity-0 transition-opacity duration-700" data-pano-stage></div>

  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 z-10 flex items-end justify-center pb-4 transition-opacity duration-500"
    data-pano-hint
    hidden
  >
    <p class="rounded-full bg-black/55 px-3.5 py-1.5 font-mono text-[0.625rem] uppercase tracking-[0.16em] text-white/90 backdrop-blur-sm">
      <span class="sm:hidden">{twoFingers ? "Two fingers to look around" : "Drag to look around"}</span>
      <span class="hidden sm:inline">Drag to look around</span>
    </p>
  </div>

  <noscript>
    <p class="absolute inset-x-0 bottom-0 bg-black/60 p-3 text-center font-mono text-[0.625rem] uppercase tracking-[0.16em] text-white">
      Enable JavaScript to explore this panorama
    </p>
  </noscript>
</div>

<style is:global>
  /* Photo Sphere Viewer paints its own chrome; align it with the site tokens. */
  .pano .psv-container {
    background: #000;
  }

  /*
    The stock navbar is a full-width black bar with oversized glyphs that sits
    on top of the caption block. Float it instead: a small centred pill, clear
    of the safe area, so the panorama keeps the whole frame.
  */
  .pano .psv-navbar {
    left: 50%;
    transform: translateX(-50%);
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    width: auto;
    height: auto;
    align-items: center;
    gap: 0.125rem;
    padding: 0.25rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 9999px;
    background: color-mix(in srgb, black 55%, transparent);
    backdrop-filter: blur(14px);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }

  /* `navbar: false` still leaves the element behind — without this it paints as
     a 10px dot of pill chrome over the sphere. */
  .pano .psv-navbar:empty {
    display: none;
  }

  /*
    PSV sets `box-sizing: content-box` on the navbar *and* keeps a 10px padding
    on every button, so a plain `width: 40px` renders a 60px disc with a tiny
    glyph marooned in the middle. Reset both before sizing anything.
  */
  .pano .psv-navbar,
  .pano .psv-navbar * {
    box-sizing: border-box;
  }

  /*
    PSV anchors its tooltips to the viewer, not the button, so on a floating
    navbar they land *under* the pill as a grey slab. Four self-evident icons
    do not need labels — and on a phone a tooltip only ever appears mid-tap.
  */
  .pano .psv-tooltip {
    display: none;
  }

  .pano .psv-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 9999px;
    color: rgb(255 255 255 / 0.92);
    transition: background-color 200ms ease;
  }

  .pano .psv-button svg {
    width: 20px;
    height: 20px;
  }

  /*
    Hover only where a pointer can actually hover — on a touch screen `:hover`
    latches after a tap and leaves the button filled in, which is what made the
    gyroscope look permanently pressed.
  */
  @media (hover: hover) {
    .pano .psv-button:hover {
      background: color-mix(in srgb, hsl(var(--chrome-accent)) 26%, transparent);
    }
  }

  /* Matches the specificity of the plugin's own `:focus-visible` rule, which
     would otherwise win the cascade and paint an off-palette blue ring. */
  .pano .psv-button:not(.psv-button--disabled):focus-visible {
    background: none;
    outline: 2px solid hsl(var(--chrome-accent));
    outline-offset: -3px;
  }

  /*
    The "cannot be loaded" overlay, which a reader now actually sees when a
    texture fails twice. PSV ships it as a near-white radial gradient with a
    black title and a glyph half the width of the viewer — correct for its
    default light chrome, unreadable on a black one, and far louder than a
    transient network failure deserves. Every colour it sets has to be answered,
    not just the background.
  */
  .pano .psv-overlay {
    background: #000;
    opacity: 1;
  }

  .pano .psv-overlay-image {
    color: rgb(255 255 255 / 0.32);
  }

  .pano .psv-overlay-image svg {
    /* PSV sizes this at 50% of the viewer; `text-align` on the parent does not
       centre it once it is this small, so centre the box itself. */
    display: block;
    width: 3rem;
    height: 3rem;
    margin-inline: auto;
  }

  .pano .psv-overlay-title {
    margin-top: 1rem;
    font: 800 1.125rem/1.3 var(--type-display);
    letter-spacing: -0.01em;
    color: rgb(255 255 255 / 0.92);
  }

  .pano .psv-overlay-text {
    font: 400 0.625rem/1.6 var(--type-meta);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
  }

  /* Toggles (gyroscope, fullscreen) tint their glyph rather than their whole disc. */
  .pano .psv-button.psv-button--active {
    background: none;
    color: hsl(var(--chrome-accent));
  }

  /*
    Quality is a cycler, not a menu: one button that steps up through the
    textures the archive holds for this panorama.

    It shows signal bars — one per available size, lit up to the one on screen —
    because that is the shape every reader already knows for "how much of this
    am I getting", and because the unlit bars above are what say a better one
    exists. The old button read out its *destination* ("8K" while you were
    watching 4K), which is unambiguous only once you already know the rule.
    The bars carry the state; the number beside them names it.

    It is the only button in the pill with text in it, so it sizes to its
    contents rather than taking the 40px disc the glyph buttons use.
  */
  .pano .psv-button.pano-quality {
    width: auto;
    min-width: 40px;
    gap: 0.4375rem;
    padding-inline: 0.625rem;
    font-family: var(--type-meta);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .pano .pano-quality__bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    /* Matches the cap height of the label sitting next to it. */
    height: 0.75rem;
  }

  .pano .pano-quality__bars i {
    width: 3px;
    border-radius: 1px;
    background: currentColor;
    /* Unlit rungs stay visible: an empty slot is the whole signal that there is
       somewhere left to go. */
    opacity: 0.28;
    transition:
      opacity 220ms ease,
      background-color 220ms ease;
  }

  /* Ascending, shortest first — 5px, 8.5px, 12px for a three-rung ladder. */
  .pano .pano-quality__bars i:nth-child(1) { height: 42%; }
  .pano .pano-quality__bars i:nth-child(2) { height: 71%; }
  .pano .pano-quality__bars i:nth-child(3) { height: 100%; }

  /* Two rungs only: skip the middle height so they still read as a climb. */
  .pano .pano-quality__bars[data-count='2'] i:nth-child(1) { height: 55%; }
  .pano .pano-quality__bars[data-count='2'] i:nth-child(2) { height: 100%; }

  .pano .pano-quality__bars i[data-lit] {
    opacity: 1;
    background: hsl(var(--chrome-accent));
  }

  /*
    Mid-swap the lit bars still describe what is on screen — they must not jump
    ahead of the pixels. The rung being fetched pulses instead, so the wait
    reads as "that one is coming" rather than as a dead grey button.
  */
  .pano .psv-button.pano-quality[data-busy] {
    pointer-events: none;
  }

  .pano .psv-button.pano-quality[data-busy] .pano-quality__label {
    opacity: 0.55;
  }

  .pano .pano-quality__bars i[data-loading] {
    background: hsl(var(--chrome-accent));
    animation: pano-quality-pulse 900ms ease-in-out infinite;
  }

  @keyframes pano-quality-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pano .pano-quality__bars i[data-loading] {
      animation: none;
      opacity: 0.6;
    }
  }

  /*
    Three states, drawn rather than only tinted: off is the glyph at rest, the
    lit cyan says the labels are on the sphere, and the bar down the right edge
    appears when the list panel is open too. Colour alone would leave two of the
    three indistinguishable to anyone who cannot separate them.
  */
  .pano .psv-button.pano-peaks[data-peaks-state='off'] {
    color: rgb(255 255 255 / 0.55);
  }

  .pano .psv-button.pano-peaks[data-peaks-state='labels'],
  .pano .psv-button.pano-peaks[data-peaks-state='panel'] {
    color: hsl(var(--chrome-accent));
  }

  /* The two parts that come and go — the panel bar, and the snow line that
     drops out when the labels are off — are switched by `paintPeaksButton`,
     which sets their opacity on the node. All this contributes is the fade. */
  .pano .pano-peaks .peaks-icon__panel,
  .pano .pano-peaks .peaks-icon__snow {
    transition: opacity 180ms ease;
  }

  /*
    Peak labels. A hairline dropped onto the summit with the name stacked above
    it — the convention every panorama board on a mountain top uses, and it
    survives a crowded skyline far better than pins or boxes would.
  */
  /*
    Bound to `--visible` deliberately. Photo Sphere Viewer hides a marker that
    has left the field of view with `.psv-marker { display: none }`, and a plain
    `.pano .peak-pin` rule outranks it — which left every marker behind the
    camera parked at wherever it was last drawn, piling into a heap against the
    edge of the screen. Matching the plugin's own class hands that decision back.
  */
  .pano .peak-pin.psv-marker--visible {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Labels are annotation, not furniture: never eat a drag meant for the sphere. */
    pointer-events: none;
    text-align: center;
    white-space: nowrap;
  }

  /*
    A hazy ridge line at 30 km is low-contrast grey-blue, and white text with a
    drop shadow disappears into it. The plate is what makes the label readable
    against any part of the sky or the ground it happens to land on.
  */
  .pano .peak-pin__plate {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.0625rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 0.375rem;
    background: color-mix(in srgb, black 62%, transparent);
    backdrop-filter: blur(6px);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.45);
    transition: opacity 140ms ease;
  }

  /* Muted by the on-screen collision pass; the stem below it stays. */
  .pano .peak-pin__plate--crowded {
    opacity: 0;
  }

  .pano .peak-pin__name {
    font-family: var(--type-meta);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
  }

  .pano .peak-pin__meta {
    font-family: var(--type-meta);
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    color: rgb(255 255 255 / 0.72);
  }

  .pano .peak-pin__stem {
    position: relative;
    width: 1px;
    /*
      Labels near each other along the horizon are handed different tiers, and
      the stem is where that becomes visible: each row hangs its plate a little
      higher, so a crowded ridge reads as a stack rather than a pile.
    */
    height: calc(1.25rem + var(--peak-tier, 0) * 2.2rem);
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.25), rgb(255 255 255 / 0.85));
  }

  /* The dot marks the summit itself; the marker is anchored so this lands on it. */
  .pano .peak-pin__stem::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: -2px;
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: hsl(var(--chrome-accent));
    box-shadow: 0 0 6px hsl(var(--chrome-accent) / 0.8);
  }

  .pano .psv-caption {
    padding-inline: 0.5rem;
  }

  .pano .psv-caption-content {
    font-family: var(--type-meta);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.8);
  }

  .pano .psv-loader-canvas circle + circle {
    stroke: hsl(var(--chrome-accent));
  }

  /*
    iPhone Safari has no element Fullscreen API, so PSV emulates it by pinning
    its own container with `.psv-fullscreen-emulation` at z-index 9999. That
    z-index is meaningless here: `.pano` sets `isolation: isolate`, which traps
    it in a stacking context that paints below the sticky header and the hero's
    caption overlay — the panorama does go full-screen, it is just buried. Lift
    the whole `.pano` instead, and swap in `dvh` so the collapsing URL bar does
    not crop the sphere.
  */
  .pano:has(.psv-fullscreen-emulation) {
    isolation: auto;
    z-index: 60;
  }

  .pano .psv-fullscreen-emulation {
    height: 100dvh !important;
  }

  body:has(.psv-fullscreen-emulation) {
    overflow: hidden;
  }

  /*
    The minimap sits clear of the safe area and gets a border matching the
    control pill, so the two read as one system rather than two libraries.
  */
  .pano .psv-map {
    top: max(0.75rem, env(safe-area-inset-top));
    right: max(0.75rem, env(safe-area-inset-right));
  }

  /* The border goes on the container, which is the element the round shape
     actually clips — on the outer box it draws a square around a circle. */
  .pano .psv-map__container {
    border: 1px solid rgb(255 255 255 / 0.16);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.35);
  }

  /* Maximized the plugin drops its own margin to fill the frame; the safe-area
     inset above would leave it hanging off the opposite edge. */
  .pano .psv-map--maximized {
    top: 0;
    right: 0;
  }

  /* Enough to place yourself, not enough to bury the sphere. Maximized the map
     takes over the frame, so the cap only applies to the minimap. */
  @media (max-width: 480px) {
    .pano .psv-map:not(.psv-map--maximized) {
      width: 140px !important;
      height: 140px !important;
    }
  }

  /*
    The plugin sizes its corner buttons at a fixed 34px, which is a quarter of
    the minimap's diameter each, and the zoom readout covers the middle of it.
    Both are built for the 300px map in the plugin's demo. Shrink the buttons and
    drop the readout while small — pinch and wheel still zoom — and hand
    everything back at full size once maximized.
  */
  .pano .psv-map:not(.psv-map--maximized) .psv-map__button {
    width: 26px;
  }

  .pano .psv-map:not(.psv-map--maximized) .psv-map__toolbar {
    display: none;
  }

  .pano .psv-map__button {
    color: rgb(255 255 255 / 0.92);
  }

  /*
    Real fullscreen promotes PSV's own container, so page chrome drops out for
    free. The emulation has no such power — anything painted over the sphere is
    still there — so page furniture opts out by hand with `data-pano-chrome`.
  */
  body:has(.psv-fullscreen-emulation) [data-pano-chrome] {
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  /*
    The plugin stylesheets are imported statically while their code stays
    dynamic. Importing them alongside the dynamic `import()` emitted <link> tags
    for CSS chunks the build never wrote — two guaranteed 404s. They are 5 kB
    together against 68 kB of plugin JS, so only the JS is worth splitting.
  */
  import "@photo-sphere-viewer/map-plugin/index.css";
  import "@photo-sphere-viewer/markers-plugin/index.css";

  import type { Viewer } from "@photo-sphere-viewer/core";
  // Type-only, so these erase at build time and pull in no chunk.
  import type { MapPlugin as MapPluginType } from "@photo-sphere-viewer/map-plugin";
  import type { MarkersPlugin as MarkersPluginType } from "@photo-sphere-viewer/markers-plugin";

  /** One texture the sphere can show. `short` is what the quality button reads. */
  type Resolution = { id: string; label: string; short?: string; panorama: string };

  type PanoElement = HTMLElement & {
    _panoViewer?: Viewer;
    _panoBoot?: Promise<Viewer | null>;
    /** Set by `pano:meta`; empty until the archive says which sizes exist. */
    _panoResolutions?: Resolution[];
    _panoResolutionIndex?: number;
    /** Set once the peak labels are on; re-runs the collision pass on demand. */
    _panoDeclutter?: () => void;
  };

  /** Cached across every viewer on the page — three.js should load exactly once. */
  let libraryPromise: Promise<{
    Viewer: typeof import("@photo-sphere-viewer/core").Viewer;
    GyroscopePlugin: typeof import("@photo-sphere-viewer/gyroscope-plugin").GyroscopePlugin;
    AutorotatePlugin: typeof import("@photo-sphere-viewer/autorotate-plugin").AutorotatePlugin;
  }> | null = null;

  function loadLibrary() {
    libraryPromise ??= (async () => {
      const [core, gyro, autorotate] = await Promise.all([
        import("@photo-sphere-viewer/core"),
        import("@photo-sphere-viewer/gyroscope-plugin"),
        import("@photo-sphere-viewer/autorotate-plugin"),
        import("@photo-sphere-viewer/core/index.css"),
      ]);
      return {
        Viewer: core.Viewer,
        GyroscopePlugin: gyro.GyroscopePlugin,
        AutorotatePlugin: autorotate.AutorotatePlugin,
      };
    })();
    return libraryPromise;
  }

  /*
    The map and settings/resolution plugins are opt-in per viewer and load in
    their own chunks. The hero sphere on the home page wants neither, and both
    ship CSS as well as JS — no reason to make every visitor pay for a minimap
    they will not see.
  */
  let mapPromise: Promise<typeof import("@photo-sphere-viewer/map-plugin").MapPlugin> | null = null;

  function loadMapPlugin() {
    mapPromise ??= (async () => {
      const plugin = await import("@photo-sphere-viewer/map-plugin");
      return plugin.MapPlugin;
    })();
    return mapPromise;
  }

  let markersPromise: Promise<typeof import("@photo-sphere-viewer/markers-plugin").MarkersPlugin> | null = null;

  function loadMarkersPlugin() {
    markersPromise ??= (async () => {
      const plugin = await import("@photo-sphere-viewer/markers-plugin");
      return plugin.MarkersPlugin;
    })();
    return markersPromise;
  }

  /**
   * Quality switching used to be the settings + resolution plugins: a gear
   * button, a panel, a "Quality" row, a submenu — four taps and two extra
   * bundles to move between two textures. With only ever a handful of sizes it
   * is a cycler instead: one button, stepping up through them and wrapping back
   * to the smallest, driven by `viewer.setPanorama` (which keeps the current
   * view position).
   */
  const QUALITY_BUTTON_ID = "quality";

  function shortLabel(resolution: Resolution): string {
    return (resolution.short || resolution.id).toUpperCase();
  }

  /**
   * Signal bars: one rung per size the archive holds, lit up to the one on
   * screen, with the current size named beside them.
   *
   * The button used to read out its *destination* — "8K" while you were looking
   * at the 4K texture — which only parses once you already know that is the
   * rule. Bars are the shape everyone already reads as "how much of this am I
   * getting", and the unlit rungs above are what say there is more to be had.
   * The action moves to `aria-label`, where it can be a whole sentence.
   */
  function paintQualityButton(el: PanoElement, viewer: Viewer) {
    const button = viewer.navbar.getButton(QUALITY_BUTTON_ID, false)?.container;
    if (!button) return;

    const list = el._panoResolutions ?? [];
    // One size is not a choice, and a lone bar reads as a broken control.
    if (list.length < 2) {
      button.style.display = "none";
      return;
    }

    const index = el._panoResolutionIndex ?? 0;
    const current = list[index];
    const next = list[(index + 1) % list.length];

    button.style.display = "";

    // Built as nodes rather than a template: `pano:meta` is a public event, so
    // the labels it carries go in as text and never as markup.
    button.replaceChildren();

    const bars = document.createElement("span");
    bars.className = "pano-quality__bars";
    bars.dataset.count = String(list.length);
    bars.setAttribute("aria-hidden", "true");
    for (let i = 0; i < list.length; i++) {
      const bar = document.createElement("i");
      if (i <= index) bar.dataset.lit = "";
      bars.append(bar);
    }

    const label = document.createElement("span");
    label.className = "pano-quality__label";
    label.setAttribute("aria-hidden", "true");
    label.textContent = shortLabel(current);

    button.append(bars, label);

    // Screen readers get the state and the consequence; the bars are decoration
    // to them. The wrap back to the smallest is worth saying out loud — it is
    // the one step the bars cannot draw, since every rung goes dark at once.
    const wraps = index === list.length - 1;
    const action = wraps ? `back down to ${next.label}` : `up to ${next.label}`;
    button.setAttribute("aria-label", `Quality: ${current.label}. Switch ${action}.`);
  }

  async function cycleQuality(el: PanoElement, viewer: Viewer) {
    const list = el._panoResolutions ?? [];
    if (list.length < 2) return;

    const button = viewer.navbar.getButton(QUALITY_BUTTON_ID, false)?.container;
    const index = ((el._panoResolutionIndex ?? 0) + 1) % list.length;
    const next = list[index];

    /*
      A second tap mid-swap would queue a texture nobody asked for, so the
      button stops listening until this one lands. The lit bars keep describing
      what is actually on screen — only the rung being fetched pulses, which is
      the honest way to show a texture that is on its way but not yet visible.
    */
    button?.setAttribute("data-busy", "");
    button?.querySelectorAll<HTMLElement>(".pano-quality__bars i")[index]?.setAttribute("data-loading", "");

    try {
      await viewer.setPanorama(next.panorama, { transition: false, showLoader: true });
      el._panoResolutionIndex = index;
    } finally {
      button?.removeAttribute("data-busy");
      // Repaint rebuilds the bars, which clears the pulse along with them.
      paintQualityButton(el, viewer);
    }
  }

  /*
    The summits button. A triangle with a snow cap — the same shape the peak
    labels point at, and small enough to read at 20px next to the quality bars.
  */
  const PEAKS_BUTTON_ID = "peaks";

  /*
    A mountain, plus a bar down the right edge standing in for the list panel.
    The bar is only drawn in the third state, so the glyph itself says which of
    the three the button is in rather than relying on colour alone.
  */
  const PEAKS_ICON =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">' +
    '<path class="peaks-icon__mount" d="M2 19 8.5 7l4 7 2-3 4.5 8z"/>' +
    '<path class="peaks-icon__snow" d="m6.4 12.4 2.1 1.3 2.1-1.3"/>' +
    '<path class="peaks-icon__panel" d="M21.5 4.5v15" stroke-linecap="round"/>' +
    "</svg>";

  /** off → labels on the sphere → labels and the list → off. */
  type PeaksState = "off" | "labels" | "panel";

  const PEAKS_NEXT: Record<PeaksState, string> = {
    off: "Summits hidden. Show the labels.",
    labels: "Summit labels on. Show the list as well.",
    panel: "Summit labels and list on. Turn them off.",
  };

  /**
   * Which of the three states the button is in, and whether it belongs on the
   * pill at all.
   *
   * Both are the page's business, not the viewer's: summits need coordinates,
   * and a panorama without them has nothing to label. The button therefore
   * ships hidden and stays hidden until someone says otherwise.
   */
  function paintPeaksButton(
    el: PanoElement,
    viewer: Viewer,
    available: boolean,
    state: PeaksState,
    controls?: string,
  ) {
    const button = viewer.navbar.getButton(PEAKS_BUTTON_ID, false)?.container;
    if (!button) return;

    button.style.display = available ? "" : "none";
    button.dataset.peaksState = state;

    /*
      The two icon parts that change are set here rather than by an attribute
      selector on the button. PSV writes the SVG itself, and a rule reaching
      from the button down into markup a plugin owns is one refactor away from
      silently not applying — which is exactly what it did. Setting the property
      on the node leaves nothing to the cascade; the transition still comes from
      CSS, so it still fades.
    */
    const panelBar = button.querySelector<SVGElement>(".peaks-icon__panel");
    if (panelBar) panelBar.style.opacity = state === "panel" ? "1" : "0";

    const snow = button.querySelector<SVGElement>(".peaks-icon__snow");
    if (snow) snow.style.opacity = state === "off" ? "0" : "1";
    // Three states, so `aria-pressed` cannot describe it — the name carries
    // where it is and what a tap does next. `aria-expanded` still tracks the
    // panel, which is the part that has a controlled element.
    button.setAttribute("aria-label", PEAKS_NEXT[state]);
    button.setAttribute("aria-expanded", String(state === "panel"));
    if (controls) button.setAttribute("aria-controls", controls);
  }

  /**
   * The observer and a `pano:load` event can both ask for the same element, and
   * `build` awaits the library — so a `_panoViewer` check alone leaves a window
   * where two viewers get mounted into one container. Cache the promise instead.
   */
  function boot(el: PanoElement) {
    // Never cache a src-less attempt: the observer fires before `pano:load`
    // supplies the URL, and a memoised null would block the real boot.
    if (!el.dataset.src) return Promise.resolve(null);

    if (!el._panoBoot) {
      const attempt = build(el);
      /*
        A build that throws — a three.js chunk that 404s after a deploy, a
        browser that refuses a WebGL context — must not poison the element.
        `pano:load` fires a second time on /view/ once the archive metadata
        lands, and that attempt has to be able to try again rather than being
        handed back the same rejected promise. The `catch` here also gives the
        rejection a handler, so clearing the cache costs no console noise.
      */
      attempt.catch(() => {
        if (el._panoBoot === attempt) el._panoBoot = undefined;
      });
      el._panoBoot = attempt;
    }

    return el._panoBoot;
  }

  /**
   * PSV names its buttons with a `title` attribute, which the browser renders as
   * a native tooltip — a grey system slab that lands on top of the floating pill
   * mid-tap. Move the name to `aria-label` so screen readers keep it and the
   * tooltip goes away.
   */
  /**
   * Stop the navbar from folding itself into a "Menu" panel.
   *
   * Photo Sphere Viewer collapses buttons whenever the bar's own width is less
   * than the buttons it holds — sensible for the stock full-width bar, wrong for
   * ours, which is a shrink-to-fit pill and so is *always* exactly as wide as
   * its contents. The result was a side panel listing the quality and gyroscope
   * buttons that were sitting right there in the bar. The bar is five small
   * round buttons; there is nothing here worth hiding behind a menu.
   */
  function disableNavbarCollapse(viewer: Viewer) {
    type NavbarButton = { uncollapse?: () => void; hide?: (refresh: boolean) => void; autoSize?: () => void };
    const navbar = (viewer as unknown as { navbar?: NavbarButton & { collapsed?: NavbarButton[]; getButton?: (id: string, warn?: boolean) => NavbarButton | null } }).navbar;
    if (!navbar) return;

    const keepOpen = () => {
      for (const button of navbar.collapsed ?? []) button.uncollapse?.();
      navbar.collapsed = [];
      navbar.getButton?.("menu", false)?.hide?.(false);
      // The caption still has to re-measure itself on resize; that part of
      // `autoSize` was doing useful work.
      navbar.getButton?.("caption", false)?.autoSize?.();
    };

    navbar.autoSize = keepOpen;
    keepOpen();
  }

  /**
   * Hide the labels that land on top of each other.
   *
   * The page already spreads the peaks around the horizon and stacks close
   * neighbours into rows, but whether two plates actually overlap depends on the
   * zoom — the same ridge is comfortable at 40° of field and a solid wall of text
   * at 100°. So the last word is taken here, on screen, every time the view
   * moves: walk the labels most striking summit first, and mute any whose plate
   * would land on one already kept. The stem and its dot stay, so a muted label
   * still reads as "a named summit, there" rather than vanishing outright.
   */
  function watchForCollisions(viewer: Viewer, el: PanoElement) {
    /** Breathing room between two plates, in pixels. */
    const GAP = 6;

    let queued = false;

    const resolve = () => {
      queued = false;
      const entries = Array.from(el.querySelectorAll<HTMLElement>(".peak-pin__plate"))
        .map((plate) => ({ plate, rank: Number(plate.dataset.rank ?? 0), rect: plate.getBoundingClientRect() }))
        // A marker outside the field of view is not laid out at all.
        .filter((entry) => entry.rect.width > 0)
        .sort((a, b) => a.rank - b.rank);

      const kept: DOMRect[] = [];
      for (const entry of entries) {
        const clashes = kept.some(
          (rect) =>
            entry.rect.left < rect.right + GAP &&
            entry.rect.right + GAP > rect.left &&
            entry.rect.top < rect.bottom + GAP &&
            entry.rect.bottom + GAP > rect.top,
        );
        entry.plate.classList.toggle("peak-pin__plate--crowded", clashes);
        if (!clashes) kept.push(entry.rect);
      }
    };

    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(resolve);
    };

    el._panoDeclutter = schedule;
    // `render` fires once per frame while the view moves; the flag collapses a
    // burst of them into a single pass, and a still sphere costs nothing.
    if (!el.dataset.declutter) {
      viewer.addEventListener("render", schedule);
      el.dataset.declutter = "true";
    }
    schedule();
  }

  function labelButtons(root: HTMLElement) {
    for (const button of root.querySelectorAll<HTMLElement>(".psv-button[title]")) {
      const label = button.title;
      if (label) button.setAttribute("aria-label", label);
      button.removeAttribute("title");
    }
  }

  const DEG = Math.PI / 180;

  /**
   * A viewpoint carried in the URL hash: `#v=<yaw>,<pitch>,<zoom>`, degrees and
   * percent. Copying the address bar while looking at something therefore hands
   * the next reader that same view rather than the panorama's default heading —
   * which is the whole difference between "look at this photo" and "look at
   * THIS, in the photo".
   */
  function readHashView(): { yaw: number; pitch: number; zoom: number } | null {
    const raw = /[#&]v=([^&]+)/.exec(window.location.hash)?.[1];
    if (!raw) return null;
    const [yaw, pitch, zoom] = raw.split(",").map(Number);
    if (![yaw, pitch, zoom].every(Number.isFinite)) return null;
    return { yaw: yaw * DEG, pitch: pitch * DEG, zoom: Math.min(100, Math.max(0, zoom)) };
  }

  function trackHash(viewer: Viewer) {
    let timer = 0;
    const write = () => {
      const { yaw, pitch } = viewer.getPosition();
      const view = `v=${(yaw / DEG).toFixed(1)},${(pitch / DEG).toFixed(1)},${Math.round(viewer.getZoomLevel())}`;
      // replaceState, not a hash assignment: the latter stacks a history entry
      // per drag, and the back button would then walk the reader through every
      // glance they took instead of leaving the page.
      history.replaceState(history.state, "", `${window.location.pathname}${window.location.search}#${view}`);
    };
    const schedule = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(write, 500);
    };
    viewer.addEventListener("position-updated", schedule);
    viewer.addEventListener("zoom-updated", schedule);
  }

  /**
   * The little-planet opening.
   *
   * Equirectangular photos have no natural "first frame", so the viewer starts
   * looking straight down through a heavy fisheye — the whole scene curled into
   * a globe — and unrolls to eye level. It doubles as an honest signal that this
   * is a sphere and not a wide photograph, which no tooltip ever conveys as well.
   */
  function playIntro(viewer: Viewer, target: { yaw: number; pitch: number; zoom: number }) {
    const start = performance.now();
    // PSV animates at an angular speed rather than for a duration; 6rpm covers
    // the 90° climb out of the planet in roughly this long, which is what the
    // fisheye tween below has to match.
    const duration = 2500;

    const step = (now: number) => {
      const t = Math.min(1, (now - start) / duration);
      // Ease out: most of the distortion is gone early, so the tail of the
      // animation is a slow settle rather than a lurch.
      viewer.setOption("fisheye", 2 * (1 - t) ** 2);
      if (t < 1) requestAnimationFrame(step);
      else viewer.setOption("fisheye", false);
    };
    requestAnimationFrame(step);

    void viewer.animate({ ...target, speed: "6rpm" });
  }

  async function build(el: PanoElement) {
    const src = el.dataset.src;
    if (!src) return null;

    const stage = el.querySelector<HTMLElement>("[data-pano-stage]");
    const poster = el.querySelector<HTMLElement>("[data-pano-poster]");
    const hint = el.querySelector<HTMLElement>("[data-pano-hint]");
    if (!stage) return null;

    const { Viewer, GyroscopePlugin, AutorotatePlugin } = await loadLibrary();

    const MapPlugin = el.dataset.map === "true" ? await loadMapPlugin() : null;
    const MarkersPlugin = el.dataset.markers === "true" ? await loadMarkersPlugin() : null;
    const quality = el.dataset.resolutions === "true";

    /** Sitting inside a scrolling page: the page's gestures win over the sphere's. */
    const embedded = el.dataset.twoFingers === "true";

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Idle rotation is opt-in, and never runs for reduced-motion users.
    const autorotate = el.dataset.autorotate === "true" && !reducedMotion;

    // A viewpoint in the URL is a deliberate instruction from whoever shared the
    // link, so it outranks both the default framing and the opening animation.
    const hashView = el.dataset.hash === "true" ? readHashView() : null;
    const intro = el.dataset.intro === "true" && !reducedMotion && !hashView;

    const viewer = new Viewer({
      container: stage,
      panorama: src,
      caption: el.dataset.caption || undefined,
      plugins: [
        GyroscopePlugin,
        [
          AutorotatePlugin,
          { autostartOnIdle: autorotate, autostartDelay: autorotate ? 1500 : null, autorotateSpeed: "1.4rpm" },
        ],
        // The minimap is stitched from OSM tiles once coordinates arrive over
        // `pano:meta`; until then it is hidden below, after construction.
        ...(MarkersPlugin ? [MarkersPlugin] : []),
        ...(MapPlugin
          ? [
              MapPlugin.withConfig({
                size: "170px",
                // Top left is taken by the back link on /view/, and the bottom
                // edge belongs to the caption block and the control pill.
                position: "top right",
                coneColor: "#22d3ee",
                pinSize: 24,
                // North is a promise the data cannot keep: no heading is
                // recorded, so the cone shows where you are looking relative to
                // the frame, not to true north.
                buttons: { north: false },
              }),
            ]
          : []),
      ],
      // Dragging already moves and pinching already zooms, so the arrow pad and
      // the zoom slider are dead weight on a phone. Caption only when there is one.
      // An explicit navbar list overrides the defaults entirely, so a plugin's
      // own button — `settings` here — has to be named or it never appears.
      navbar: el.dataset.controls === "false"
        ? false
        : [
            "zoomOut",
            "zoomIn",
            ...(el.dataset.caption ? ["caption"] : []),
            // Starts hidden and unlabelled: the sizes are only known once
            // `pano:meta` arrives, and a lone size is nothing to switch between.
            ...(quality
              ? [
                  {
                    id: QUALITY_BUTTON_ID,
                    content: "",
                    className: "pano-quality",
                    onClick: (v: Viewer) => void cycleQuality(el, v),
                  },
                ]
              : []),
            // Sits with quality rather than in the top bar: both are things you
            // do *to* the panorama you are looking at, and the top-left corner
            // is for leaving it.
            ...(el.dataset.peaks === "true"
              ? [
                  {
                    id: PEAKS_BUTTON_ID,
                    content: PEAKS_ICON,
                    className: "pano-peaks",
                    onClick: () =>
                      document.dispatchEvent(
                        new CustomEvent("pano:peaks-toggle", { detail: { target: `#${el.id}` } }),
                      ),
                  },
                ]
              : []),
            "gyroscope",
            "fullscreen",
          ],
      touchmoveTwoFingers: embedded,
      // Arrow keys and +/− only where the sphere owns the page; embedded in a
      // scrolling article the same keys belong to the document.
      keyboard: embedded ? false : "always",
      // Embedded in a scrolling page the wheel is off entirely, so a scroll just
      // scrolls — `mousewheelCtrlKey` would instead nag with a "use ctrl+scroll"
      // overlay every time. On the full-screen viewer nothing is behind the
      // sphere, so the wheel zooms directly.
      mousewheel: !embedded,
      mousewheelCtrlKey: false,
      defaultYaw: hashView?.yaw ?? 0,
      // The intro starts looking straight down through a fisheye and unrolls on
      // `ready`; everything else opens where it was asked to.
      defaultPitch: intro ? -Math.PI / 2 : (hashView?.pitch ?? 0),
      defaultZoomLvl: intro ? 0 : (hashView?.zoom ?? 35),
      fisheye: intro ? 2 : false,
      minFov: 25,
      maxFov: 100,
      moveInertia: 0.85,
      loadingTxt: "",
      canvasBackground: "#000",
    });

    el._panoViewer = viewer;

    // The navbar exists as soon as the viewer is constructed; do not wait for
    // `ready`, which never fires if the panorama itself fails to load.
    labelButtons(stage);
    disableNavbarCollapse(viewer);

    // An empty minimap is worse than none, and `visibleOnLoad: false` is the
    // wrong lever — it *collapses* the map, and a collapsed map skips the render
    // loop, so the tiles never paint once the image finally lands.
    viewer.getPlugin<MapPluginType>("map")?.hide();

    // Nothing to cycle through yet — `pano:meta` fills the list and shows it.
    if (quality) paintQualityButton(el, viewer);

    // Same for summits: hidden until the page has coordinates to justify it.
    if (el.dataset.peaks === "true") paintPeaksButton(el, viewer, false, "off");

    /*
      Reveal the stage on the first texture rather than only on `ready`.

      `ready` fires once, after the first render — and, as noted above, never at
      all if the panorama fails to load. The stage starts transparent so a
      poster can show through underneath it, which means a viewer that never
      reaches `ready` leaves an invisible layer over nothing: on /view/, where
      there is no poster to fall back to, that is a permanently black page. It
      also hides Photo Sphere Viewer's own loader and error overlay, so a slow
      or failed texture gives the reader no feedback at all.

      `panorama-loaded` fires whenever pixels actually arrive, including for
      every later `setPanorama`, so it is the honest signal that there is
      something to show. Both handlers are idempotent.
    */
    const reveal = () => {
      stage.style.opacity = "1";
    };

    viewer.addEventListener("panorama-loaded", reveal);

    /*
      With nothing slotted into the poster there is no fallback to reveal —
      holding the stage back only hides Photo Sphere Viewer's own loader and
      leaves the reader staring at black while a texture downloads. Show it as
      soon as there is a viewer to show. Pages that do pass a poster (the
      gallery hero) keep the fade, which is the whole reason it exists.
    */
    if (!poster || poster.children.length === 0) reveal();

    /*
      A ~1 MB texture failing once is the common case — a phone changing
      networks mid-load, a cold Worker, a dropped connection — and until now the
      only evidence of it was a black rectangle that never resolved. Retry once,
      quietly; if the second attempt fails too, reveal the stage so PSV's own
      error overlay is at least visible instead of being hidden behind it.
    */
    let retriedTexture = false;

    viewer.addEventListener("panorama-error", () => {
      if (retriedTexture) {
        reveal();
        return;
      }
      retriedTexture = true;
      const retrySrc = el.dataset.src;
      if (!retrySrc) {
        reveal();
        return;
      }
      window.setTimeout(() => {
        void viewer.setPanorama(retrySrc, { caption: el.dataset.caption || undefined }).catch(reveal);
      }, 800);
    });

    viewer.addEventListener("ready", () => {
      reveal();
      labelButtons(stage);
      if (intro) playIntro(viewer, { yaw: 0, pitch: 0, zoom: 35 });
      if (el.dataset.hash === "true") trackHash(viewer);
      // Hold the poster one beat longer so there is no black flash between them.
      window.setTimeout(() => poster?.classList.add("opacity-0"), 250);

      if (hint) {
        hint.hidden = false;
        const dismiss = () => {
          hint.style.opacity = "0";
          el.removeEventListener("pointerdown", dismiss);
        };
        el.addEventListener("pointerdown", dismiss, { once: true });
        window.setTimeout(dismiss, 4500);
      }
    });

    return viewer;
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        void boot(entry.target as PanoElement);
      }
    },
    // Start fetching just before it scrolls in — three.js takes a moment.
    { rootMargin: "200px 0px" },
  );

  for (const el of document.querySelectorAll<PanoElement>("[data-pano]")) {
    observer.observe(el);
  }

  /**
   * Metadata arrives after the sphere is already turning — the viewer boots from
   * a URL the page can build from `?id=` alone, while coordinates and file sizes
   * come from a separate archive request. So the map and the quality picker are
   * filled in by their own event rather than being part of `pano:load`.
   */
  document.addEventListener("pano:meta", async (event: Event) => {
    const { target, lat, lon, resolutions } = (event as CustomEvent).detail as {
      target: string;
      lat?: number | null;
      lon?: number | null;
      resolutions?: Resolution[];
    };
    const el = document.querySelector<PanoElement>(target);
    if (!el) return;

    // `_panoBoot` rather than `_panoViewer`: metadata usually lands while the
    // viewer is still constructing, and awaiting the promise is the only way to
    // avoid dropping it on the floor.
    const viewer = await (el._panoBoot ?? Promise.resolve(el._panoViewer ?? null));
    if (!viewer) return;

    if (resolutions?.length) {
      // The first entry is the texture the viewer booted from — start the cycle
      // there so the button offers the next size up rather than a reload.
      el._panoResolutions = resolutions;
      el._panoResolutionIndex = 0;
      paintQualityButton(el, viewer);
    }

    if (lat != null && lon != null) {
      const plugin = viewer.getPlugin<MapPluginType>("map");
      if (plugin) {
        const { buildStaticMap } = await import("@/lib/staticmap");
        const map = await buildStaticMap(lat, lon);
        // Null means every tile failed — a blocked host or no network. The
        // panorama is unaffected, so leave the map hidden and say nothing.
        if (map) {
          plugin.setImage(map.url, map.center);
          plugin.show();
        }
      }
    }
  });

  /** Swing the view to a point on the sphere — used by the peak list. */
  document.addEventListener("pano:look", async (event: Event) => {
    const { target, yaw, pitch } = (event as CustomEvent).detail as { target: string; yaw: number; pitch: number };
    const el = document.querySelector<PanoElement>(target);
    if (!el) return;

    const viewer = await (el._panoBoot ?? Promise.resolve(el._panoViewer ?? null));
    if (!viewer) return;

    // Reduced motion still moves the view — it just arrives instead of sweeping.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) viewer.rotate({ yaw, pitch });
    else void viewer.animate({ yaw, pitch, speed: "8rpm" });
  });

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  /**
   * Peak labels, computed by the page and handed over as sphere coordinates —
   * the viewer knows nothing about mountains, only about yaw and pitch. An empty
   * list clears them, which is what happens when the panorama has no heading and
   * the labels would otherwise point at the wrong summits.
   */
  document.addEventListener("pano:peaks", async (event: Event) => {
    const { target, peaks } = (event as CustomEvent).detail as {
      target: string;
      peaks: Array<{ id: string; name: string; detail: string; tier?: number; rank?: number; yaw: number; pitch: number }>;
    };
    const el = document.querySelector<PanoElement>(target);
    if (!el) return;

    const viewer = await (el._panoBoot ?? Promise.resolve(el._panoViewer ?? null));
    const plugin = viewer?.getPlugin<MarkersPluginType>("markers");
    if (!plugin) return;

    watchForCollisions(viewer!, el);

    plugin.setMarkers(
      peaks.map((peak) => ({
        id: peak.id,
        position: { yaw: peak.yaw, pitch: peak.pitch },
        // The tier lengthens the stem, which lifts the plate clear of whatever
        // else the page decided sits close to it along the horizon.
        html: `<span class="peak-pin__plate" data-rank="${Math.max(0, Math.round(peak.rank ?? 0))}"><span class="peak-pin__name">${escapeHtml(peak.name)}</span><span class="peak-pin__meta">${escapeHtml(peak.detail)}</span></span><span class="peak-pin__stem" style="--peak-tier:${Math.max(0, Math.round(peak.tier ?? 0))}"></span>`,
        className: "peak-pin",
        // The dot at the foot of the stem is what sits on the summit.
        anchor: "bottom center",
        // A little give with the field of view, but never so small that the
        // name stops being readable — which is the only reason it is there.
        scale: { zoom: [0.9, 1.1] },
      })),
    );
  });

  /** The other half of `pano:peaks-toggle`: the page answering about its panel. */
  document.addEventListener("pano:peaks-button", async (event: Event) => {
    const { target, available, state, controls } = (event as CustomEvent).detail as {
      target: string;
      available: boolean;
      state?: PeaksState;
      controls?: string;
    };
    const el = document.querySelector<PanoElement>(target);
    if (!el) return;

    // Same reason as `pano:meta`: the archive usually answers while the viewer
    // is still constructing, so await the boot rather than dropping the state.
    const viewer = (await el._panoBoot) ?? el._panoViewer;
    if (!viewer) return;

    paintPeaksButton(el, viewer, available, state ?? "off", controls);
  });

  // Let other scripts (the gallery's lightbox) drive a viewer directly.
  document.addEventListener("pano:load", (event: Event) => {
    const { target, src, caption } = (event as CustomEvent).detail as {
      target: string;
      src: string;
      caption?: string;
    };
    const el = document.querySelector<PanoElement>(target);
    if (!el) return;

    /*
      Asking for the panorama already on screen is not a no-op — `setPanorama`
      cancels whatever texture is in flight and starts again, and cancelling is
      not an error, so nothing is emitted and nothing recovers. The stage would
      sit at zero opacity forever: a black page.

      That is exactly what /view/ used to do. It fires `pano:load` immediately
      from the URL so the sphere starts downloading, then fires it a second time
      with the same URL once the archive listing lands. Whenever the ~1 MB
      texture was still arriving at that moment, the second call killed the
      first — which is why a cold load could hang while the same link opened
      instantly from the gallery, where the image was already in cache.
    */
    const changed = el.dataset.src !== src;
    el.dataset.src = src;
    if (caption !== undefined) el.dataset.caption = caption;

    if (el._panoViewer) {
      if (!changed) {
        // Same photo. The caption may still have arrived late — that is the
        // one thing a repeat call legitimately carries.
        if (caption !== undefined) el._panoViewer.setOption("caption", caption);
        return;
      }
      // A different photo: last one's textures and summits belong to it, not this.
      el._panoResolutions = [];
      el._panoResolutionIndex = 0;
      el._panoViewer.getPlugin<MarkersPluginType>("markers")?.clearMarkers();
      void el._panoViewer.setPanorama(src, { caption, transition: { effect: "fade" } });
    } else {
      void boot(el);
    }
  });
</script>
