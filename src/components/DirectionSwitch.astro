---
/*
  Theme switcher. All three design directions ship as complete token sets in
  `src/index.css`, so switching is one attribute on <html> — no CSS reload, no
  flash. The choice persists in localStorage and is applied by the inline head
  script in Layout.astro before first paint.
*/

const DIRECTIONS = [
	{ id: "dark-room", label: "Dark", title: "Dark Room — cool near-black" },
	{ id: "flight-log", label: "Log", title: "Flight Log — warm-black, amber instrument glow" },
	{ id: "paper-sky", label: "Paper", title: "Paper Sky — near-white gallery print" },
];
---

<div
  class="flex items-center gap-0.5 rounded-full border border-border/70 p-0.5"
  role="group"
  aria-label="Theme"
  data-direction-switch
>
  {
    DIRECTIONS.map(({ id, label, title }) => (
      <button
        type="button"
        data-set-direction={id}
        title={title}
        aria-pressed="false"
        class="min-h-11 rounded-full px-3.5 sm:min-h-9 font-mono text-[0.5625rem] uppercase tracking-[0.12em] text-muted-foreground transition-colors hover:text-foreground aria-pressed:bg-brand-primary aria-pressed:text-brand-accent-foreground sm:px-3 sm:text-[0.625rem]"
      >
        {label}
      </button>
    ))
  }
</div>

<script>
  const THEME_COLORS: Record<string, string> = {
    "dark-room": "#0b1015",
    "flight-log": "#100c09",
    "paper-sky": "#f8fbfc",
  };

  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-set-direction]");

  function paint(current: string) {
    for (const button of buttons) {
      button.setAttribute("aria-pressed", String(button.dataset.setDirection === current));
    }
    document.querySelector('meta[name="theme-color"]')?.setAttribute("content", THEME_COLORS[current] ?? "#0b1015");
  }

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const next = button.dataset.setDirection;
      if (!next) return;
      document.documentElement.dataset.direction = next;
      try {
        localStorage.setItem("direction", next);
      } catch {
        // private mode — the choice just won't survive a reload
      }
      paint(next);
    });
  }

  paint(document.documentElement.dataset.direction ?? "dark-room");
</script>
