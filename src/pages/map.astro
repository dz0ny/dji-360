---
import Layout from "@/layouts/Layout.astro";
import { SITE_NAME, SITE_URL } from "@/config";
import type { WithContext, CollectionPage } from "schema-dts";

/*
  Where every panorama was flown.

  The archive listing already carries lat/lon for anything the camera geotagged,
  so this page is the same `/~/api/photos` payload read a second way. MapLibre is
  imported by the page script rather than the layout — it is the heaviest thing
  on the site and only this route needs it.

  The map is drawn in 3D over real terrain, following MapLibre's own 3d-terrain
  example, because most of these panoramas are flown over mountains and a flat
  slippy map throws that away. Neither source needs a key, unlike the MapTiler
  tiles that example uses:

  - raster basemap — openstreetmap.org, the same host `staticmap.ts` already
    uses for the in-viewer minimap;
  - elevation — the AWS Terrain Tiles open dataset, in Mapzen's `terrarium`
    encoding, draped under the raster as both the DEM and a hillshade.

  The CSP already allows both (`img-src https:`), and MapLibre's blob workers
  are covered by `worker-src blob:`.

  DESIGN — the map is dressed as the camera's own display rather than as a
  widget: a live telemetry readout of the centre — coordinates, zoom, and the
  ground elevation the DEM reports there — in the bottom-left, and pins
  that carry a viewfinder cone when the camera recorded which way the frame faced.
  Both carry real information. Corner framing marks were tried and cut — they
  read as decoration and collided with the zoom control.
*/

import "maplibre-gl/dist/maplibre-gl.css";

const DESCRIPTION = "Every geotagged 360° panorama in the archive, plotted on one map.";

const schema: WithContext<CollectionPage> = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: `Map | ${SITE_NAME}`,
	description: DESCRIPTION,
	url: `${SITE_URL}/map/`,
};
---

<Layout title="Map" description={DESCRIPTION} schema={schema}>
  <section class="mx-auto max-w-[1600px] px-[var(--spacing-gutter)] pt-10" aria-labelledby="map-title">
    <div class="mb-5 flex flex-wrap items-end justify-between gap-x-8 gap-y-4 border-b border-border/70 pb-4">
      <div>
        <p class="font-mono text-[0.625rem] uppercase tracking-[0.22em] text-brand-primary animate-rise">
          Flight map
        </p>
        <h1
          id="map-title"
          class="mt-2 font-display text-[clamp(1.75rem,5vw,3rem)] font-extrabold leading-[0.95] tracking-[-0.03em] animate-rise [animation-delay:100ms]"
        >
          Where these were shot
        </h1>
      </div>

      <dl
        class="grid grid-cols-3 gap-x-6 gap-y-1 font-mono text-[0.625rem] uppercase tracking-[0.16em] animate-rise [animation-delay:200ms] sm:grid-cols-[auto_auto] sm:justify-end sm:gap-x-4 sm:text-right"
      >
        <div class="sm:contents">
          <dt class="text-muted-foreground">Pinned</dt>
          <dd class="whitespace-nowrap text-base font-bold tracking-normal text-foreground sm:text-sm" data-stat-pinned>—</dd>
        </div>
        <div class="sm:contents">
          <dt class="text-muted-foreground">Sites</dt>
          <dd class="whitespace-nowrap text-base font-bold tracking-normal text-foreground sm:text-sm" data-stat-sites>—</dd>
        </div>
        <div class="sm:contents">
          <dt class="text-muted-foreground">Unlocated</dt>
          <dd class="whitespace-nowrap text-base font-bold tracking-normal text-foreground sm:text-sm" data-stat-missing>—</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-[1600px] px-[var(--spacing-gutter)] pb-[var(--spacing-section)]">
    <div class="relative overflow-hidden rounded-lg border border-border/70 bg-muted shadow-soft">
      <div
        id="flight-map"
        class="h-[62dvh] min-h-[380px] w-full lg:h-[calc(100dvh-15rem)] lg:min-h-[540px]"
        role="application"
        aria-label="Map of panorama locations"
      ></div>

      {/* Telemetry. Whatever the map is centred on, in the camera's own units. */}
      <p class="map-readout" data-map-readout aria-hidden="true"></p>

      {/* Covers the map until MapLibre paints, so tiles never fade in over a bare box. */}
      <div
        class="pointer-events-none absolute inset-0 z-[600] grid place-items-center bg-muted font-mono text-[0.625rem] uppercase tracking-[0.16em] text-muted-foreground transition-opacity duration-500"
        data-map-veil
      >
        Loading the map
      </div>
    </div>

    <p class="mt-3 hidden text-sm text-destructive" data-map-error role="alert"></p>
  </section>
</Layout>

<style>
  /* Bottom-left so it never collides with MapLibre's attribution, which is
     pinned bottom-right and must stay legible. */
  .map-readout {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    z-index: 500;
    pointer-events: none;
    padding: 0.3125rem 0.5rem;
    border: 1px solid hsl(var(--brand-primary) / 0.3);
    border-radius: var(--radius-sm);
    background: hsl(var(--background) / 0.78);
    backdrop-filter: blur(8px);
    font-family: var(--type-meta);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    /* Empty until the map reports a centre — an empty box would just be a smudge. */
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .map-readout:not(:empty) {
    opacity: 1;
  }

  .map-readout b {
    font-weight: 700;
    color: hsl(var(--brand-primary));
  }
</style>

<style is:global>
  /*
    MapLibre stamps its own class names on the elements it creates, so none of
    this can be scoped — Astro's scoping attribute never lands on them.
    Everything below is namespaced under `#flight-map` or a `pano-` class.
  */

  /* OSM ships one bright raster set. In Dark Room it would glow like a lightbox
     in the middle of the page, so the canvas — tiles, hillshade, and sky alike —
     is inverted back into the palette. Because the invert is paired with a 180°
     hue rotation it flips lightness while keeping hue, so the sky stays blue
     rather than turning orange. Paper Sky leaves it as drawn.

     Declared twice for the same reason the palettes are: a media query and a
     plain selector cannot share one block. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-direction='paper-sky']) #flight-map .maplibregl-canvas {
      filter: invert(1) hue-rotate(180deg) brightness(0.92) contrast(0.9) saturate(0.7);
    }

    :root:not([data-direction='paper-sky']) #flight-map .maplibregl-ctrl-icon {
      filter: invert(1);
    }
  }

  [data-direction='dark-room'] #flight-map .maplibregl-canvas {
    filter: invert(1) hue-rotate(180deg) brightness(0.92) contrast(0.9) saturate(0.7);
  }

  /* MapLibre's control glyphs are black SVGs baked into its stylesheet; on a
     dark control they would be invisible. */
  [data-direction='dark-room'] #flight-map .maplibregl-ctrl-icon {
    filter: invert(1);
  }

  #flight-map {
    background: hsl(var(--muted));
    /* The map owns its gestures; the page must never scroll under a drag. */
    touch-action: none;
    font-family: var(--type-body);
  }

  #flight-map .maplibregl-ctrl-attrib {
    background: hsl(var(--background) / 0.8);
    color: hsl(var(--muted-foreground));
    font-family: var(--type-meta);
    font-size: 0.5625rem;
  }

  #flight-map .maplibregl-ctrl-attrib a {
    color: hsl(var(--brand-primary));
  }

  #flight-map .maplibregl-ctrl-group {
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius-sm);
    background: hsl(var(--background) / 0.85);
    backdrop-filter: blur(8px);
    box-shadow: none;
  }

  #flight-map .maplibregl-ctrl-group button {
    background: transparent;
    color: hsl(var(--foreground));
  }

  #flight-map .maplibregl-ctrl-group button + button {
    border-top-color: hsl(var(--border));
  }

  #flight-map .maplibregl-ctrl-group button:hover {
    background: hsl(var(--accent));
  }

  /* The 3D toggle is a state, not a one-shot action, so it says which one it
     is in rather than leaving the reader to guess from the horizon. */
  #flight-map .maplibregl-ctrl-terrain-enabled {
    background: hsl(var(--brand-primary) / 0.18);
  }

  /* ── Pins ──────────────────────────────────────────────────────────────
     A divIcon rather than Leaflet's default PNG pin: the bundled image paths
     break under Vite, and a CSS dot can take the brand colour, a count, and a
     viewfinder cone. */
  .pano-pin {
    position: relative;
    display: grid;
    place-items: center;
    /* Matches the map plugin's own pin: an 18px dot inside a 2px light ring
       (its pin.svg draws r=190 white under r=150 colour at pinSize 35). */
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 9999px;
    border: 2px solid hsl(var(--background));
    background: hsl(var(--brand-primary));
    color: hsl(var(--brand-accent-foreground));
    box-shadow: 0 2px 12px hsl(0 0% 0% / 0.5);
    font-family: var(--type-meta);
    font-size: 0.5625rem;
    font-weight: 700;
    line-height: 1;
    /* MOTION: pins drop in one after another once the map has framed them.
       `backwards` keeps the start state during the delay and hands the element
       back to its own transform afterwards, so hover still scales cleanly. */
    animation: pin-drop 520ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: var(--pin-delay, 0ms);
    transition:
      transform 180ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 180ms ease;
  }

  @keyframes pin-drop {
    from {
      opacity: 0;
      transform: translateY(-0.75rem) scale(0.4);
    }
  }

  /*
    Which way the centre of the frame faces, when the camera recorded it — the
    same heading the peak labels are placed against. Sites without one get a
    plain dot rather than a guessed direction.

    Shaped as the same translucent viewfinder cone the Photo Sphere Viewer map
    plugin draws around its own pin, so a site reads identically here and inside
    the panorama: a wedge fanning out from the dot, fading with distance.
  */
  .pano-pin-wrap {
    position: relative;
    display: block;
    width: 1.25rem;
    height: 1.25rem;
  }

  /*
    The plugin fills a circular sector on canvas: a `coneSize` radius, an arc
    spanning the current horizontal FOV centred on the view, and a radial
    gradient that is solid out to `coneSize / 4` and transparent at the rim.
    Same numbers here — 40px radius, ~70deg spread — with a conic mask standing
    in for the arc, so the wedge keeps its rounded outer edge.
  */
  .pano-pin__cone {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 5rem;
    height: 5rem;
    margin: -2.5rem 0 0 -2.5rem;
    pointer-events: none;
    background: radial-gradient(
      circle at 50% 50%,
      hsl(var(--brand-primary)) 25%,
      hsl(var(--brand-primary) / 0) 100%
    );
    /* `from` is measured clockwise from twelve o'clock — the same convention
       the heading is recorded in, so no extra rotation is needed. */
    --cone-mask: conic-gradient(
      from calc(var(--heading, 0deg) - 35deg),
      #000 0deg 70deg,
      transparent 70deg
    );
    -webkit-mask-image: var(--cone-mask);
    mask-image: var(--cone-mask);
    opacity: 0.75;
    animation: cone-in 520ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: var(--pin-delay, 0ms);
    transition:
      background 180ms ease,
      opacity 180ms ease;
  }

  @keyframes cone-in {
    from {
      opacity: 0;
    }
  }

  .pano-pin-wrap:has(.pano-pin[data-active]) .pano-pin__cone,
  .pano-pin-wrap:focus-visible .pano-pin__cone,
  .pano-pin-wrap:hover .pano-pin__cone {
    background: radial-gradient(
      circle at 50% 50%,
      hsl(var(--brand-accent)) 25%,
      hsl(var(--brand-accent) / 0) 100%
    );
    opacity: 0.9;
  }

  .pano-pin-wrap:focus-visible .pano-pin,
  .pano-pin:hover,
  .pano-pin[data-active] {
    transform: scale(1.25);
    background: hsl(var(--brand-accent));
  }

  /* ── Popup ─────────────────────────────────────────────────────────────
     MapLibre's default is a white bubble with a white tail; both are repainted
     so the popup belongs to whichever direction is active. The tail is a CSS
     border triangle whose colour lives on a different edge for every anchor,
     which is why it takes four rules rather than one. */
  .maplibregl-popup-content {
    overflow: hidden;
    padding: 0;
    width: 15rem;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    background: hsl(var(--popover));
    color: hsl(var(--popover-foreground));
    box-shadow: var(--shadow-3);
  }

  .maplibregl-popup-anchor-top .maplibregl-popup-tip,
  .maplibregl-popup-anchor-top-left .maplibregl-popup-tip,
  .maplibregl-popup-anchor-top-right .maplibregl-popup-tip {
    border-bottom-color: hsl(var(--popover));
  }

  .maplibregl-popup-anchor-bottom .maplibregl-popup-tip,
  .maplibregl-popup-anchor-bottom-left .maplibregl-popup-tip,
  .maplibregl-popup-anchor-bottom-right .maplibregl-popup-tip {
    border-top-color: hsl(var(--popover));
  }

  .maplibregl-popup-anchor-left .maplibregl-popup-tip {
    border-right-color: hsl(var(--popover));
  }

  .maplibregl-popup-anchor-right .maplibregl-popup-tip {
    border-left-color: hsl(var(--popover));
  }

  /* The bubble opens on a photograph, and a bright sky swallows a bare glyph —
     so the close control carries its own disc. */
  .maplibregl-popup-close-button {
    top: 0.375rem;
    right: 0.375rem;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border-radius: 9999px;
    background: hsl(var(--background) / 0.65);
    backdrop-filter: blur(8px);
    color: hsl(var(--foreground) / 0.8);
    font-size: 1rem;
    line-height: 1.375rem;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  .maplibregl-popup-close-button:hover {
    background: hsl(var(--background) / 0.9);
    color: hsl(var(--brand-primary));
  }

  .pano-popup__shot {
    display: block;
    color: inherit;
  }

  .pano-popup__shot + .pano-popup__shot {
    border-top: 1px solid hsl(var(--border));
  }

  .pano-popup__shot:hover .pano-popup__title {
    color: hsl(var(--brand-primary));
  }

  .pano-popup__shot img {
    display: block;
    width: 100%;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
  }

  .pano-popup__body {
    display: block;
    padding: 0.625rem 0.75rem 0.75rem;
  }

  .pano-popup__title {
    display: block;
    font-family: var(--type-display);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: hsl(var(--popover-foreground));
    transition: color 150ms ease;
  }

  .pano-popup__meta {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--type-meta);
    font-size: 0.5625rem;
    line-height: 1.6;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  /* More than one panorama from the same take-off point: the bubble scrolls
     rather than growing past the map. */
  .pano-popup--stack {
    max-height: 17rem;
    overflow-y: auto;
  }

  .pano-popup--stack .pano-popup__shot img {
    aspect-ratio: 1200 / 360;
  }

</style>

<script>
  import * as maplibregl from "maplibre-gl";
  import type { StyleSpecification } from "maplibre-gl";
  import {
    displayTitle,
    escapeHtml,
    fetchPhotos,
    formatCoords,
    formatDate,
    photoDate,
    viewUrl,
    type Photo,
  } from "@/lib/photos";

  /**
   * One pin per take-off point, not per photo. Repeat flights from the same spot
   * land within a few metres of each other and would stack into an unclickable
   * pile; rounding to four decimals (~11 m) merges them into a single pin whose
   * popup lists the lot.
   */
  interface Site {
    key: string;
    lat: number;
    lon: number;
    photos: Photo[];
  }

  const errorEl = document.querySelector<HTMLElement>("[data-map-error]");
  const veilEl = document.querySelector<HTMLElement>("[data-map-veil]");
  const readoutEl = document.querySelector<HTMLElement>("[data-map-readout]");

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function setStat(selector: string, value: string) {
    const el = document.querySelector<HTMLElement>(selector);
    if (el) el.textContent = value;
  }

  function hasCoords(photo: Photo): boolean {
    return photo.lat != null && photo.lon != null;
  }

  /** Metres above sea level where the camera knew it, above take-off otherwise. */
  function altitudeOf(photo: Photo): number | null {
    return photo.altitudeAmsl ?? photo.altitude;
  }

  function groupSites(photos: Photo[]): Site[] {
    const sites = new Map<string, Site>();

    for (const photo of photos) {
      if (!hasCoords(photo)) continue;
      const lat = photo.lat as number;
      const lon = photo.lon as number;
      const key = `${lat.toFixed(4)},${lon.toFixed(4)}`;
      const existing = sites.get(key);
      if (existing) {
        existing.photos.push(photo);
      } else {
        sites.set(key, { key, lat, lon, photos: [photo] });
      }
    }

    // Newest site first, matching the order the archive itself reads in.
    return [...sites.values()].sort((a, b) => {
      const at = photoDate(a.photos[0])?.getTime() ?? 0;
      const bt = photoDate(b.photos[0])?.getTime() ?? 0;
      return bt - at;
    });
  }

  /** A place has no name of its own, so a site borrows its newest frame's. */
  function siteLabel(site: Site): string {
    return displayTitle(site.photos[0]);
  }

  function popupHtml(site: Site): string {
    const stack = site.photos.length > 1;

    const shots = site.photos
      .map((photo) => {
        const title = escapeHtml(displayTitle(photo));
        const date = escapeHtml(formatDate(photo));
        const coords = escapeHtml(formatCoords(photo));
        const altitude = altitudeOf(photo);
        const height = altitude == null ? "" : ` · ${Math.round(altitude)} m`;

        return `
          <a class="pano-popup__shot" href="${viewUrl(photo.id)}">
            <img
              src="${photo.cover}"
              data-fallback="${photo.thumb}"
              alt="360° panorama — ${title}"
              width="240"
              height="126"
              loading="lazy"
              decoding="async"
            />
            <span class="pano-popup__body">
              <span class="pano-popup__title">${title}</span>
              <span class="pano-popup__meta">${date}${height}${stack ? "" : `<br />${coords}`}</span>
            </span>
          </a>`;
      })
      .join("");

    return `<div class="${stack ? "pano-popup--stack" : ""}">${shots}</div>`;
  }

  /**
   * Covers from before the horizon crop existed 404, so each one falls back to
   * its 2:1 thumb — the same swap the card grid does. If that misses too the
   * image is removed: a bubble this small cannot afford a dead grey block above
   * the caption. Popups build their DOM when they open, so this runs once per
   * popup rather than once per page.
   */
  function coverFallback(root: HTMLElement) {
    for (const img of root.querySelectorAll<HTMLImageElement>("img[data-fallback]")) {
      img.addEventListener("error", () => {
        const fallback = img.dataset.fallback;
        if (fallback) {
          img.removeAttribute("data-fallback");
          img.src = fallback;
        } else {
          img.remove();
        }
      });
    }
  }

  /**
   * MapLibre markers take a DOM node rather than an HTML string, and unlike
   * Leaflet's they are not focusable on their own — hence the explicit button
   * role, so the pins stay reachable from the keyboard.
   */
  function pinElement(site: Site, index: number): HTMLElement {
    const count = site.photos.length;
    // Stagger the drop-in, but cap it so a long archive is not still landing
    // pins after a second and a half.
    const delay = reducedMotion ? 0 : Math.min(index, 12) * 45;
    // The cone is only honest when a camera actually recorded the heading.
    const heading = site.photos.find((photo) => photo.heading != null)?.heading;
    const cone =
      heading == null
        ? ""
        : `<span class="pano-pin__cone" style="--heading:${heading}deg;--pin-delay:${delay}ms"></span>`;

    const el = document.createElement("div");
    el.className = "pano-pin-wrap";
    el.tabIndex = 0;
    el.setAttribute("role", "button");
    el.setAttribute("aria-label", siteLabel(site));
    el.innerHTML = `${cone}<span class="pano-pin" style="--pin-delay:${delay}ms">${count > 1 ? count : ""}</span>`;
    return el;
  }

  /**
   * The centre of the map, in the units the camera writes into its own files.
   * The elevation is the DEM's reading for that point, so it is absent while
   * terrain is switched off or its tiles have not landed yet.
   */
  function renderReadout(map: maplibregl.Map) {
    if (!readoutEl) return;
    const center = map.getCenter();
    const ns = center.lat >= 0 ? "N" : "S";
    const ew = center.lng >= 0 ? "E" : "W";
    const ground = map.queryTerrainElevation(center);
    readoutEl.innerHTML =
      `${Math.abs(center.lat).toFixed(4)}°${ns} ${Math.abs(center.lng).toFixed(4)}°${ew}` +
      ` <b>Z${map.getZoom().toFixed(1)}</b>` +
      (ground == null ? "" : ` ${Math.round(ground)} m`);
  }

  async function load() {
    const container = document.getElementById("flight-map");
    if (!container) return;

    let photos: Photo[];
    try {
      photos = await fetchPhotos();
    } catch (error) {
      if (errorEl) {
        errorEl.textContent = error instanceof Error ? error.message : "Could not load the archive.";
        errorEl.classList.remove("hidden");
      }
      if (veilEl) veilEl.textContent = "Map unavailable";
      return;
    }

    const sites = groupSites(photos);
    const pinned = photos.filter(hasCoords).length;

    setStat("[data-stat-pinned]", String(pinned));
    setStat("[data-stat-sites]", String(sites.length));
    setStat("[data-stat-missing]", String(photos.length - pinned));

    if (sites.length === 0) {
      // The stat row above already says how many are unlocated; the veil only
      // has to explain why the map stayed empty.
      if (veilEl) veilEl.textContent = "Nothing carries a GPS tag yet";
      return;
    }

    // ── Map ──────────────────────────────────────────────────────────────
    /*
      An inline style rather than a hosted one: two keyless raster sources are
      all this needs, and a style URL would be a third-party dependency for a
      page that already knows exactly what it wants drawn.
    */
    const style: StyleSpecification = {
      version: 8,
      sources: {
        osm: {
          type: "raster",
          tiles: ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
          tileSize: 256,
          maxzoom: 19,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        },
        // Mapzen's terrarium encoding, hosted as an AWS open dataset. Global
        // coverage stops at z15, which is finer than the DEM itself resolves.
        terrain: {
          type: "raster-dem",
          tiles: ["https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"],
          tileSize: 256,
          maxzoom: 15,
          encoding: "terrarium",
          attribution: '<a href="https://registry.opendata.aws/terrain-tiles/">Terrain Tiles</a>',
        },
      },
      layers: [
        { id: "osm", type: "raster", source: "osm" },
        // OSM draws contours but no relief. A light hillshade off the same DEM
        // keeps the ridges readable while the map is still looking straight down.
        {
          id: "hillshade",
          type: "hillshade",
          source: "terrain",
          paint: { "hillshade-exaggeration": 0.3 },
        },
      ],
      sky: {
        "sky-color": "#8ec5ff",
        "horizon-color": "#dcecff",
        "fog-color": "#dcecff",
        "sky-horizon-blend": 0.7,
        "horizon-fog-blend": 0.6,
        "fog-ground-blend": 0.6,
      },
      terrain: { source: "terrain", exaggeration: 1 },
    };

    const bounds = new maplibregl.LngLatBounds();
    for (const site of sites) bounds.extend([site.lon, site.lat]);

    const map = new maplibregl.Map({
      container,
      style,
      center: bounds.getCenter(),
      zoom: 12,
      // Tilted from the first frame: a 3D map that opens flat looks broken.
      pitch: 60,
      maxPitch: 85,
      // One finger pans: the map is what this page is, unlike the spheres
      // embedded in a scrolling gallery. The wheel is the one gesture held
      // back, below, because that one belongs to the page.
      scrollZoom: false,
      attributionControl: { compact: true },
    });

    map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), "top-right");
    // Terrain ships on in the style above, so this button turns it off.
    map.addControl(new maplibregl.TerrainControl({ source: "terrain", exaggeration: 1 }), "top-right");

    // Ctrl/⌘ + wheel zooms; a bare wheel keeps scrolling the page.
    container.addEventListener(
      "wheel",
      (event) => {
        if (!event.ctrlKey && !event.metaKey) return;
        event.preventDefault();
        map.zoomTo(map.getZoom() - Math.sign(event.deltaY), { duration: 200 });
      },
      { passive: false },
    );

    const markers = sites.map((site, index) => {
      const popup = new maplibregl.Popup({
        maxWidth: "260px",
        closeButton: true,
        // Clear of the dot, which is anchored on its own centre.
        offset: 16,
      }).setHTML(popupHtml(site));

      const element = pinElement(site, index);
      const marker = new maplibregl.Marker({ element, anchor: "center" })
        .setLngLat([site.lon, site.lat])
        .setPopup(popup)
        .addTo(map);

      // MapLibre binds the popup to a click; the keyboard has to be wired up.
      element.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        marker.togglePopup();
      });

      popup.on("open", () => {
        const node = popup.getElement();
        if (node) coverFallback(node);
        setActive(index);
      });
      popup.on("close", () => setActive(null));

      return marker;
    });

    /*
      An open popup keeps its own pin lit. With pins packed this close the
      reader otherwise loses track of which one they opened.
    */
    function setActive(index: number | null) {
      markers.forEach((marker, i) => {
        const pin = marker.getElement().querySelector<HTMLElement>(".pano-pin");
        pin?.toggleAttribute("data-active", i === index);
      });
    }

    map.on("move", () => renderReadout(map));

    /*
      `fitBounds` solves for the container's pixel size, and MapLibre measured
      that when the map was constructed — before the browser had laid the grid
      out. A stale size makes it frame the wrong window, so re-measure on the
      next frame and only then frame the pins.
    */
    const frame = () => {
      map.resize();
      // A single site has zero-area bounds, which `fitBounds` cannot solve for.
      if (sites.length === 1) {
        map.jumpTo({ center: bounds.getCenter(), zoom: 14, pitch: 60 });
      } else {
        map.fitBounds(bounds, { padding: 56, maxZoom: 15, pitch: 60, duration: 0 });
      }
      renderReadout(map);
    };

    map.once("load", () => {
      frame();
      veilEl?.classList.add("opacity-0");
    });

    // And again after layout settles, in case the grid or the fonts moved anything.
    requestAnimationFrame(frame);
  }

  void load();
</script>
