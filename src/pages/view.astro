---
import Layout from "@/layouts/Layout.astro";
import PanoViewer from "@/components/PanoViewer.astro";

/*
  Chromeless viewer. The page is prerendered and reads the id off the URL on the
  client (`/p/<id>/`, or the legacy `?id=`), so the sphere starts loading from
  the constructed image URL immediately rather than waiting on the archive
  listing — the title and coordinates fill in a moment later.

  `worker/pano.js` serves this same HTML for every `/p/<id>/`, rewriting the head
  so a shared link previews as that photo. The `noindex` below therefore applies
  only to the bare shell — the worker drops it on a real panorama.

  Moving between panoramas never reloads the page: the sphere is a three.js
  scene that costs a second to rebuild, so ‹ / › swap the texture and push a new
  URL instead.
*/
---

<Layout title="Viewer" noindex bare>
  <div class="relative h-dvh w-full overflow-hidden bg-black">
    {/* One finger looks around here: nothing behind this page needs scrolling.
        Sized with h-full rather than `absolute inset-0` — the component root is
        already `relative`, and Tailwind's stylesheet order makes that win over a
        caller's `absolute`, which would collapse the sphere to zero height. */}
    <PanoViewer id="stage" class="h-full w-full" twoFingers={false} map resolutions intro hash markers peaks>
      {/*
        The thumb shows while the sphere downloads. Without it the page stays
        black for as long as the texture takes.

        The thumb is the whole sphere, flat. The first frame of the sphere looks
        at the horizon with a vertical field of 100°. So the image is 180° tall,
        scaled to 180% of the frame and centred, and the two line up.

        The blur hides the bend between a flat projection and the sphere. The
        Worker sets `src` on `/p/<id>/`, so the poster paints before any script.
      */}
      <img
        data-view-poster
        alt=""
        aria-hidden="true"
        decoding="async"
        class="absolute left-1/2 top-1/2 h-[180%] w-auto max-w-none -translate-x-1/2 -translate-y-1/2 blur-md"
      />
    </PanoViewer>

    <div
      data-pano-chrome
      class="pointer-events-none absolute inset-x-0 top-0 z-20 bg-gradient-to-b from-black/70 to-transparent pb-12 transition-opacity duration-300"
      style="padding-top:max(0.75rem, env(safe-area-inset-top))"
    >
      {/* Leaving, and moving between panoramas. Anything you do *to* the
          panorama in front of you lives in the control pill at the bottom. */}
      <div class="flex flex-wrap items-center gap-1.5 px-3">
        <a href="/" class="view-chip">
          <span aria-hidden="true">←</span> Gallery
        </a>

        {/* Keyboard equivalents are [ and ] — the arrow keys belong to the sphere. */}
        <button type="button" class="view-chip view-chip--icon" data-view-prev aria-label="Previous panorama" hidden>
          <span aria-hidden="true">‹</span>
        </button>
        <button type="button" class="view-chip view-chip--icon" data-view-next aria-label="Next panorama" hidden>
          <span aria-hidden="true">›</span>
        </button>

        {/* The one place to start a reel. It opens a row rather than rendering
            straight away: there is a choice of aspect, and a fifteen-second
            render is too long a commitment to start from a single tap. */}
        <button
          type="button"
          class="view-chip"
          data-reel-open
          aria-expanded="false"
          aria-controls="reel-formats"
          hidden
        >
          <span aria-hidden="true">▶</span> Reel
        </button>

        {/* Then and now: the same place on another date. A tap swaps the
            panorama and keeps the camera on the same compass bearing. */}
        <div class="contents" data-then-now role="group" aria-label="This place on other dates"></div>
      </div>

      <div id="reel-formats" class="mt-1.5 flex flex-wrap items-center gap-1.5 px-3" data-reel-formats hidden>
        <button type="button" class="view-chip" data-reel-format="story">
          Story <span class="text-white/45">9:16</span>
        </button>
        <button type="button" class="view-chip" data-reel-format="wide">
          Wide <span class="text-white/45">16:9</span>
        </button>
        <button type="button" class="view-chip" data-reel-cancel hidden>Cancel</button>
        <p class="pointer-events-none font-mono text-[0.5625rem] uppercase tracking-[0.14em] text-white/60" data-reel-status role="status"></p>
      </div>
    </div>

    <aside
      id="peaks-panel"
      data-pano-chrome
      class="absolute right-0 top-0 z-30 flex h-full w-full max-w-xs translate-x-full flex-col border-l border-white/10 bg-black/80 backdrop-blur-xl transition-transform duration-300 data-[open]:translate-x-0 sm:max-w-sm"
      style="padding-top:max(4.5rem, calc(env(safe-area-inset-top) + 4rem))"
      hidden
    >
      <header class="flex items-baseline justify-between gap-3 px-4 pb-3">
        <h2 class="font-mono text-[0.625rem] uppercase tracking-[0.16em] text-white/60">Named summits</h2>
        <button type="button" class="view-chip view-chip--icon" data-peaks-close aria-label="Close the summit list">
          <span aria-hidden="true">×</span>
        </button>
      </header>

      <p class="px-4 pb-3 font-mono text-[0.5625rem] uppercase leading-relaxed tracking-[0.14em] text-white/45" data-peaks-status></p>

      <ol class="min-h-0 flex-1 overflow-y-auto px-2 pb-6" data-peaks-list></ol>

      {/*
        Labels can only be placed on the sphere if we know which way the frame
        faces. Cameras that record it need nothing; for the rest, whoever owns
        the archive lines the labels up by eye once and it is stored for good.
      */}
      <form class="border-t border-white/10 px-4 py-3" data-peaks-calibrate hidden>
        <label class="flex items-center justify-between font-mono text-[0.5625rem] uppercase tracking-[0.14em] text-white/60">
          Frame centre faces
          <output class="text-white/90" data-peaks-heading-out></output>
        </label>
        <input
          type="range"
          min="0"
          max="359"
          step="1"
          value="0"
          class="mt-2 w-full accent-[hsl(var(--chrome-accent))]"
          data-peaks-heading
        />
        <div class="mt-2 flex items-center gap-2">
          {/* Tap the sun on the sphere, and its known bearing sets north. */}
          <button type="button" class="view-chip" data-peaks-sun aria-pressed="false">☀ From sun</button>
          <button type="submit" class="view-chip flex-1 justify-center">Save north</button>
          <span class="font-mono text-[0.5rem] uppercase tracking-[0.14em] text-white/40" data-peaks-save-status></span>
        </div>
      </form>
    </aside>

    <div
      data-pano-chrome
      class="pointer-events-none absolute inset-x-0 bottom-0 z-20 bg-gradient-to-t from-black/75 to-transparent pt-16 transition-opacity duration-300"
      style="padding-bottom:calc(3.25rem + env(safe-area-inset-bottom))"
    >
      <div class="px-4">
        <h1
          class="font-display text-[clamp(1.25rem,5vw,2.25rem)] font-extrabold leading-tight tracking-tight text-white"
          data-view-title
        >
          Loading…
        </h1>
        <p class="mt-1 font-mono text-[0.625rem] uppercase tracking-[0.16em] text-white/70" data-view-meta></p>
        <p class="mt-2 max-w-prose text-sm text-white/80" data-view-description hidden></p>
      </div>
    </div>

    <p
      class="absolute inset-0 z-30 hidden place-items-center bg-black p-8 text-center font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-white/70"
      data-view-error
      role="alert"
    ></p>
  </div>
</Layout>

<style>
  /*
    One pill shape for every control in the top bar, so the row reads as a set.

    The then-and-now chips are built in script, so they never get the scoped
    attribute. `:global` inside their container reaches them, and keeps one
    definition of the pill.
  */
  .view-chip,
  [data-then-now] :global(.view-chip) {
    display: inline-flex;
    /* The gradient behind them is click-through; the controls are not. */
    pointer-events: auto;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    border-radius: 9999px;
    background: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(12px);
    font-family: var(--type-meta);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: white;
    transition: background-color 200ms ease;
  }

  .view-chip:hover,
  [data-then-now] :global(.view-chip:hover) {
    background: rgb(0 0 0 / 0.7);
  }

  .view-chip[disabled] {
    opacity: 0.35;
    pointer-events: none;
  }

  .view-chip--icon {
    min-width: 2.75rem;
    padding-inline: 0;
    justify-content: center;
    font-size: 1.125rem;
    letter-spacing: 0;
  }

</style>

<style is:global>
  /*
    These rows are built in JavaScript, so Astro's scoped attribute is never
    stamped on them and a scoped rule would never match. Global, then, but
    namespaced by the panel that owns them.
  */
  #peaks-panel .peak-row {
    display: flex;
    width: 100%;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    text-align: left;
    transition: background-color 150ms ease;
  }

  #peaks-panel button.peak-row:hover {
    background: rgb(255 255 255 / 0.08);
  }

  #peaks-panel .peak-row__name {
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.92);
  }

  #peaks-panel .peak-row__meta {
    flex-shrink: 0;
    font-family: var(--type-meta);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.5);
  }
</style>

<script>
  import { API, SITE_NAME } from "@/config";
  import {
    cameraName,
    displayTitle,
    fetchPhotos,
    formatBytes,
    formatCoords,
    formatDate,
    mapUrl,
    photoDate,
    plainTitle,
  } from "@/lib/photos";
  import type { Photo } from "@/lib/photos";
  import {
    eyeElevation,
    fetchPeaks,
    fetchTerrain,
    formatDistance,
    GROUND_REACH,
    groundAt,
    groundHides,
    horizonAngle,
    normalizeDegrees,
    placePeaks,
    placePoint,
    spherePosition,
  } from "@/lib/peaks";
  import { lightOf, sunPosition } from "@/lib/sun";
  import type { PeaksPayload, PlacedPeak, TerrainRing } from "@/lib/peaks";
  import { canRenderReel, reelFilename, renderReel, saveReel, REEL_FORMATS } from "@/lib/reel";
  import type { ReelFormat } from "@/lib/reel";

  const ID_RE = /^[a-z0-9][a-z0-9-]{4,63}$/;

  /*
    The id arrives in the path on the shareable `/p/<id>/` URL, which the worker
    serves from this very shell. `?id=` is the older form and still works —
    links to it get rewritten in place so what the reader copies out of the
    address bar is the URL that previews properly.
  */
  function idFromLocation(): string {
    const fromPath = window.location.pathname.match(/^\/p\/([^/]+)\/?$/)?.[1] ?? "";
    return fromPath ? decodeURIComponent(fromPath) : (new URLSearchParams(window.location.search).get("id") ?? "");
  }

  const titleEl = document.querySelector<HTMLElement>("[data-view-title]");
  const metaEl = document.querySelector<HTMLElement>("[data-view-meta]");
  const descEl = document.querySelector<HTMLElement>("[data-view-description]");
  const errorEl = document.querySelector<HTMLElement>("[data-view-error]");
  const prevEl = document.querySelector<HTMLButtonElement>("[data-view-prev]");
  const nextEl = document.querySelector<HTMLButtonElement>("[data-view-next]");
  const thenNowEl = document.querySelector<HTMLElement>("[data-then-now]");
  const panelEl = document.querySelector<HTMLElement>("#peaks-panel");
  const peaksListEl = document.querySelector<HTMLElement>("[data-peaks-list]");
  const peaksStatusEl = document.querySelector<HTMLElement>("[data-peaks-status]");
  const calibrateEl = document.querySelector<HTMLFormElement>("[data-peaks-calibrate]");
  const headingInput = document.querySelector<HTMLInputElement>("[data-peaks-heading]");
  const headingOut = document.querySelector<HTMLOutputElement>("[data-peaks-heading-out]");
  const saveStatusEl = document.querySelector<HTMLElement>("[data-peaks-save-status]");
  const sunButton = document.querySelector<HTMLButtonElement>("[data-peaks-sun]");
  const reelOpenEl = document.querySelector<HTMLButtonElement>("[data-reel-open]");
  const reelFormatsEl = document.querySelector<HTMLElement>("[data-reel-formats]");
  const reelCancelEl = document.querySelector<HTMLButtonElement>("[data-reel-cancel]");
  const reelStatusEl = document.querySelector<HTMLElement>("[data-reel-status]");

  let photos: Photo[] = [];
  let current: Photo | null = null;
  let placed: PlacedPeak[] = [];
  /*
    The summits button lives in the viewer's control pill, so this page no
    longer holds it as an element — it owns the state and posts it over.
    Summits need coordinates, so a panorama without them has no button at all.

    Three states, cycled by the one button: nothing, labels on the sphere, then
    labels plus the list panel. Labels default to on, which is what the viewer
    did before there was any way to turn them off; a crowded skyline is the
    reason there is one now.
  */
  type PeaksState = "off" | "labels" | "panel";
  const PEAKS_CYCLE: Record<PeaksState, PeaksState> = { off: "labels", labels: "panel", panel: "off" };

  let peaksAvailable = false;
  let peaksState: PeaksState = "labels";
  // The camera height and the ground ring of the panorama on screen. The peak
  // lookup sets both. The arrows and the sun read them.
  let eyeHeight: number | null = null;
  let groundRing: TerrainRing | null = null;

  /** The heading being previewed, which is the stored one until an admin drags. */
  let heading: number | null = null;
  let isAdmin = false;

  function showError(message: string) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove("hidden");
    errorEl.classList.add("grid");
  }

  /** Only ever asked once, and a failure just means "not an editor". */
  async function checkAdmin() {
    try {
      const res = await fetch(API.whoami, { credentials: "include" });
      isAdmin = res.ok && (await res.json()).authorized === true;
    } catch {
      isAdmin = false;
    }
  }

  // --- the sphere -----------------------------------------------------------

  function loadSphere(photo: Photo, keepView?: { yawOffset: number }) {
    document.dispatchEvent(
      new CustomEvent("pano:load", {
        detail: { target: "#stage", src: `${API.img}/preview/${photo.id}`, keepView },
      }),
    );
    document.dispatchEvent(
      new CustomEvent("pano:meta", {
        detail: {
          target: "#stage",
          lat: photo.lat,
          lon: photo.lon,
          /*
            Order is the cycle order, and the first entry has to be the texture
            the viewer booted from. `short` is what the quality button reads — it
            sits in a pill, so it stays short — a few characters — and the full
            label goes to the aria-label.
          */
          resolutions: [
            { id: "4k", short: "4K", label: "4K preview", panorama: `${API.img}/preview/${photo.id}` },
            /*
              The 8K rung only exists for captures big enough to warrant it, and
              only for uploads made after it was added — older panoramas cycle
              straight from the preview to the original.
            */
            ...(photo.large
              ? [
                  {
                    id: "8k",
                    short: "8K",
                    label: `8K${photo.largeBytes ? ` · ${formatBytes(photo.largeBytes)}` : ""}`,
                    panorama: photo.large,
                  },
                ]
              : []),
            {
              id: "original",
              short: "Orig",
              label: `Original${photo.bytes ? ` · ${formatBytes(photo.bytes)}` : ""}`,
              panorama: photo.original,
            },
          ],
        },
      }),
    );
  }

  // --- the caption block ----------------------------------------------------

  function renderChrome(photo: Photo) {
    const title = displayTitle(photo);
    // The worker already set this for scrapers; a client-side visit needs it too.
    document.title = `${title} | ${SITE_NAME}`;
    if (titleEl) titleEl.textContent = title;

    if (metaEl) {
      // Golden or blue hour, when the light in the frame has a name. It needs
      // only the time and the place, not the heading.
      const light =
        photo.capturedAt && photo.lat != null && photo.lon != null
          ? lightOf(sunPosition(new Date(photo.capturedAt), photo.lat, photo.lon).elevation)
          : null;
      metaEl.textContent = [formatDate(photo), light, formatCoords(photo), cameraName(photo.camera), formatBytes(photo.bytes)]
        .filter(Boolean)
        .join(" · ");
      const map = mapUrl(photo);
      if (map) {
        const link = document.createElement("a");
        link.href = map;
        link.target = "_blank";
        link.rel = "noreferrer";
        link.textContent = "Map ↗";
        link.className = "pointer-events-auto ml-2 underline underline-offset-4 hover:text-white";
        metaEl.append(link);
      }
    }

    if (descEl) {
      descEl.textContent = photo.description ?? "";
      descEl.hidden = !photo.description;
    }

    const index = photos.findIndex((p) => p.id === photo.id);
    // Only one panorama in the archive means nothing to step between.
    for (const [button, target] of [
      [prevEl, index - 1],
      [nextEl, index + 1],
    ] as const) {
      if (!button) continue;
      button.hidden = photos.length < 2;
      button.disabled = target < 0 || target >= photos.length;
    }
  }

  // --- moving between panoramas --------------------------------------------

  function show(photo: Photo, { push = false, keepView }: { push?: boolean; keepView?: { yawOffset: number } } = {}) {
    current = photo;
    if (push) {
      // A fresh photo deserves a fresh viewpoint, so the old hash goes with it.
      // Then-and-now keeps the view, and the hash catches up once it lands.
      history.pushState(null, "", `/p/${encodeURIComponent(photo.id)}/`);
    }
    loadSphere(photo, keepView);
    renderChrome(photo);
    renderThenNow(photo);
    paintReel();
    void loadPeaks(photo);
  }

  function step(delta: number) {
    if (!current) return;
    const next = photos[photos.findIndex((p) => p.id === current!.id) + delta];
    if (next) show(next, { push: true });
  }

  prevEl?.addEventListener("click", () => step(-1));
  nextEl?.addEventListener("click", () => step(1));

  window.addEventListener("popstate", () => {
    const photo = photos.find((p) => p.id === idFromLocation());
    if (photo && photo.id !== current?.id) show(photo);
  });

  document.addEventListener("keydown", (event) => {
    if (event.metaKey || event.ctrlKey || event.altKey) return;
    const target = event.target as HTMLElement | null;
    if (target && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))) return;

    // Arrows and +/− are the sphere's; these are the page's.
    if (event.key === "[" || event.key === "p") step(-1);
    else if (event.key === "]" || event.key === "n") step(1);
    else if (event.key === "l") setPeaksState(PEAKS_CYCLE[peaksState]);
  });

  // --- peaks ----------------------------------------------------------------

  /** Tell the viewer's pill whether to show the button, and how to draw it. */
  function paintPeaksButton() {
    document.dispatchEvent(
      new CustomEvent("pano:peaks-button", {
        detail: { target: "#stage", available: peaksAvailable, state: peaksState, controls: "peaks-panel" },
      }),
    );
  }

  /**
   * The one place the three states are made real: labels on the sphere for the
   * last two, the panel for the last one only.
   */
  function applyPeaksState() {
    if (panelEl) {
      panelEl.hidden = false;
      panelEl.toggleAttribute("data-open", peaksState === "panel");
    }
    applyMarkers();
    paintPeaksButton();
  }

  function setPeaksState(next: PeaksState) {
    if (!peaksAvailable) return;
    peaksState = next;
    applyPeaksState();
  }

  document.addEventListener("pano:peaks-toggle", () => setPeaksState(PEAKS_CYCLE[peaksState]));

  // Closing the panel by its own × steps back to labels-only rather than all
  // the way off — the reader dismissed a list, not the summits.
  document.querySelector("[data-peaks-close]")?.addEventListener("click", () => setPeaksState("labels"));

  function setStatus(message: string) {
    if (peaksStatusEl) peaksStatusEl.textContent = message;
  }

  function renderPeakList() {
    if (!peaksListEl) return;
    peaksListEl.replaceChildren();

    for (const peak of placed) {
      const row = document.createElement("li");
      const detail = `${Math.round(peak.ele)} m · ${formatDistance(peak.distance)} · ${peak.compass}`;

      // Without a heading there is nowhere on the sphere to send the reader, so
      // the row stays a plain line of text rather than a button that lies.
      const inner = document.createElement(heading == null ? "span" : "button");
      inner.className = "peak-row";
      if (inner instanceof HTMLButtonElement) {
        inner.type = "button";
        inner.addEventListener("click", () => {
          document.dispatchEvent(
            new CustomEvent("pano:look", { detail: { target: "#stage", ...spherePosition(peak, heading!) } }),
          );
        });
      }

      const name = document.createElement("span");
      name.className = "peak-row__name";
      name.textContent = peak.name;

      const meta = document.createElement("span");
      meta.className = "peak-row__meta";
      meta.textContent = detail;

      inner.append(name, meta);
      row.append(inner);
      peaksListEl.append(row);
    }
  }

  /**
   * Push the labels onto the sphere — or clear them, when north is unknown or
   * the reader has switched them off.
   */
  function applyMarkers() {
    document.dispatchEvent(
      new CustomEvent("pano:peaks", {
        detail: {
          target: "#stage",
          peaks:
            heading == null || peaksState === "off"
              ? []
              : placed.map((peak) => ({
                  id: `peak-${peak.name}-${Math.round(peak.bearing)}`,
                  name: peak.name,
                  detail: `${Math.round(peak.ele)} m · ${formatDistance(peak.distance)}`,
                  tier: peak.tier,
                  rank: peak.rank,
                  ...spherePosition(peak, heading),
                })),
        },
      }),
    );
    applyPlaces();
  }

  // --- places: other panoramas in view, and the sun -------------------------

  /** Far enough to reach the next hill over, near enough to be worth a tap. */
  const NEIGHBOUR_RADIUS = 5000;
  const NEIGHBOUR_LIMIT = 8;
  const PANO_PREFIX = "place-pano-";

  // Other panoramas, drawn where their drone hovered.

  // Three frames of one flight are usually a few hundred metres apart, so a
  // tap on the arrow walks from one to the next. The marker sits at the other
  // drone's height, so a frame shot higher up reads as higher in the sky.
  function neighbourPlaces(photo: Photo, eye: number, north: number) {
    if (photo.lat == null || photo.lon == null) return [];
    const from = { lat: photo.lat, lon: photo.lon };

    // The other drone's height: the ground under it from the ring, plus its
    // height above take-off. The recorded sea-level figure is not to be trusted.
    const heightOf = (other: Photo) => {
      const flat = placePoint(from, { lat: other.lat!, lon: other.lon!, ele: eye }, eye);
      const ground = groundRing ? groundAt(groundRing, flat.bearing, flat.distance) : null;
      return ground != null && other.altitude != null && other.altitude > 0 && other.altitude <= 500
        ? ground + other.altitude
        : eye;
    };

    return photos
      .filter((other) => other.id !== photo.id && other.lat != null && other.lon != null)
      .map((other) => ({
        other,
        point: placePoint(from, { lat: other.lat!, lon: other.lon!, ele: heightOf(other) }, eye),
      }))
      .filter(({ point }) => point.distance <= NEIGHBOUR_RADIUS)
      // A drone behind a hill is not in view, so its arrow would point at rock.
      .filter(
        ({ point }) => !groundRing || !groundHides(groundRing, point, eye, point.distance * GROUND_REACH),
      )
      .sort((a, b) => a.point.distance - b.point.distance)
      .slice(0, NEIGHBOUR_LIMIT)
      .map(({ other, point }) => ({
        id: `${PANO_PREFIX}${other.id}`,
        kind: "panorama" as const,
        name: displayTitle(other),
        detail: `${formatDistance(point.distance)} · ${formatDate(other)}`,
        ...spherePosition(point, north),
      }));
  }

  // The sun at the moment of capture, if it stood above the horizon.

  // It doubles as a check on the stored heading. On a frame that shows the sun
  // or its glare, the disc should sit on it.
  function sunPlace(photo: Photo, eye: number, north: number) {
    if (!photo.capturedAt || photo.lat == null || photo.lon == null) return [];
    const sun = sunPosition(new Date(photo.capturedAt), photo.lat, photo.lon);
    if (sun.elevation < horizonAngle(eye)) return [];
    // Behind a ridge the sun lights the sky, but the disc is not in the frame.
    const direction = { bearing: sun.bearing, angle: sun.elevation };
    if (groundRing && groundHides(groundRing, direction, eye, Number.POSITIVE_INFINITY)) return [];
    return [
      {
        id: "place-sun",
        kind: "sun" as const,
        name: "Sun",
        detail: `Sun · ${Math.round(sun.elevation)}° up`,
        ...spherePosition({ bearing: sun.bearing, angle: sun.elevation }, north),
      },
    ];
  }

  // Everything that is not a summit. It needs north, as the peak labels do,
  // and it obeys the same switch: "off" means a clean sphere.
  function applyPlaces() {
    const photo = current;
    const eye = eyeHeight;
    const places =
      !photo || heading == null || eye == null || peaksState === "off"
        ? []
        : [...sunPlace(photo, eye, heading), ...neighbourPlaces(photo, eye, heading)];

    document.dispatchEvent(new CustomEvent("pano:places", { detail: { target: "#stage", places } }));
  }

  // --- then and now ---------------------------------------------------------

  /** A different take-off a short walk away still counts as the same place. */
  const SAME_PLACE_RADIUS = 800;
  const THEN_NOW_LIMIT = 3;

  // The same place on other days, newest first.

  // Shots from the same day are the flight's own frames, and the arrows on
  // the sphere already reach those. These chips are for coming back later.
  function otherVisits(photo: Photo): Photo[] {
    if (photo.lat == null || photo.lon == null) return [];
    const from = { lat: photo.lat, lon: photo.lon };
    const day = photoDate(photo)?.toDateString();

    const byDay = new Map<string, Photo>();
    for (const other of photos) {
      if (other.id === photo.id || other.lat == null || other.lon == null) continue;
      const otherDay = photoDate(other)?.toDateString();
      if (!otherDay || otherDay === day) continue;
      const { distance } = placePoint(from, { lat: other.lat, lon: other.lon, ele: 0 }, 0);
      if (distance > SAME_PLACE_RADIUS) continue;
      // One chip per day: the nearest frame of that visit.
      const kept = byDay.get(otherDay);
      if (!kept || placePoint(from, { lat: kept.lat!, lon: kept.lon!, ele: 0 }, 0).distance > distance) {
        byDay.set(otherDay, other);
      }
    }

    return [...byDay.values()]
      .sort((a, b) => (photoDate(b)?.getTime() ?? 0) - (photoDate(a)?.getTime() ?? 0))
      .slice(0, THEN_NOW_LIMIT);
  }

  function renderThenNow(photo: Photo) {
    if (!thenNowEl) return;
    thenNowEl.replaceChildren(
      ...otherVisits(photo).map((other) => {
        const date = photoDate(other);
        const button = document.createElement("button");
        button.type = "button";
        button.className = "view-chip";
        button.dataset.thenNow = other.id;
        button.textContent = `⇄ ${date ? date.toLocaleDateString(undefined, { month: "short", year: "numeric" }) : "Other visit"}`;
        button.setAttribute("aria-label", `Same place, ${formatDate(other)}`);
        return button;
      }),
    );
  }

  // Swap to another visit and keep looking the same way.

  // A bearing B sits at yaw `B − heading` on a sphere. So to keep the same
  // bearing, the yaw turns by the difference of the two headings. Without both
  // headings there is no honest correction, and the yaw stays as it is.
  thenNowEl?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-then-now]");
    const other = photos.find((p) => p.id === button?.dataset.thenNow);
    if (!other || !current) return;
    const yawOffset = current.heading != null && other.heading != null ? current.heading - other.heading : 0;
    show(other, { push: true, keepView: { yawOffset } });
  });

  document.addEventListener("pano:place-select", (event: Event) => {
    const { id } = (event as CustomEvent).detail as { id: string };
    if (!id.startsWith(PANO_PREFIX)) return;
    const photo = photos.find((p) => p.id === id.slice(PANO_PREFIX.length));
    if (photo) show(photo, { push: true });
  });

  function setHeading(value: number | null) {
    heading = value;
    applyMarkers();
    renderPeakList();
    if (headingOut) headingOut.textContent = value == null ? "unknown" : `${Math.round(value)}°`;
  }

  async function loadPeaks(photo: Photo) {
    placed = [];
    eyeHeight = null;
    groundRing = null;
    setHeading(photo.heading);
    renderPeakList();

    if (photo.lat == null || photo.lon == null) {
      peaksAvailable = false;
      peaksState = "labels";
      panelEl?.removeAttribute("data-open");
      paintPeaksButton();
      return;
    }

    peaksAvailable = true;
    // A new panorama starts with its labels up and the list closed, whatever
    // the last one was left on: the summits are different summits.
    peaksState = "labels";
    applyPeaksState();
    if (calibrateEl) calibrateEl.hidden = !isAdmin;
    paintSunButton();
    if (headingInput) headingInput.value = String(Math.round(photo.heading ?? 0));
    setStatus("Looking up summits…");

    // The ground ring loads beside the summits. It never fails the labels.
    const terrainRequest = fetchTerrain(photo.id);

    let payload: PeaksPayload;
    try {
      payload = await fetchPeaks(photo.id);
    } catch (error) {
      setStatus(error instanceof Error ? error.message : "Could not load nearby peaks");
      return;
    }

    // Another panorama was opened while Overpass was thinking.
    if (current?.id !== photo.id) return;

    const terrain = await terrainRequest;
    if (current?.id !== photo.id) return;

    const viewpoint = { altitude: photo.altitude, altitudeAmsl: photo.altitudeAmsl, terrain };
    eyeHeight = eyeElevation(payload, viewpoint);
    groundRing = terrain;
    placed = placePeaks(payload, viewpoint);
    if (!placed.length) {
      setStatus("No named summits stand above this horizon.");
    } else if (photo.heading == null) {
      setStatus(
        isAdmin
          ? `${placed.length} summits · no recorded north — align the labels below`
          : `${placed.length} summits, by compass bearing · this panorama has no recorded north, so they can't be placed on the sphere`,
      );
    } else {
      setStatus(`${placed.length} summits within ${Math.round(payload.radius / 1000)} km`);
    }

    setHeading(photo.heading);
  }

  // --- north from the sun ---------------------------------------------------

  // The sun's bearing at the moment of capture is known to a fraction of a
  // degree. Tap the sun on the sphere, and the tap's yaw plus the heading must
  // equal that bearing. One tap fixes north on a frame that has none.
  let pickingSun = false;

  function sunOf(photo: Photo | null) {
    if (!photo?.capturedAt || photo.lat == null || photo.lon == null) return null;
    const sun = sunPosition(new Date(photo.capturedAt), photo.lat, photo.lon);
    // Below the horizon there is no disc to tap.
    return sun.elevation > -1 ? sun : null;
  }

  function paintSunButton() {
    if (!sunButton) return;
    pickingSun = false;
    sunButton.setAttribute("aria-pressed", "false");
    const sun = sunOf(current);
    sunButton.disabled = !sun;
    sunButton.title = sun ? "Tap this, then tap the sun on the sphere" : "The sun was below the horizon";
  }

  sunButton?.addEventListener("click", () => {
    if (!sunOf(current)) return;
    pickingSun = !pickingSun;
    sunButton.setAttribute("aria-pressed", String(pickingSun));
    if (saveStatusEl) saveStatusEl.textContent = pickingSun ? "Tap the sun" : "";
  });

  document.addEventListener("pano:click", (event: Event) => {
    if (!pickingSun) return;
    const sun = sunOf(current);
    if (!sun) return;
    const { yaw } = (event as CustomEvent).detail as { yaw: number; pitch: number };

    pickingSun = false;
    sunButton?.setAttribute("aria-pressed", "false");
    const value = normalizeDegrees(sun.bearing - (yaw * 180) / Math.PI);
    if (headingInput) headingInput.value = String(Math.round(value));
    setHeading(value);
    if (saveStatusEl) saveStatusEl.textContent = "Set from the sun · save to keep";
  });

  // Dragging previews the alignment live: the labels swing across the sphere and
  // you stop when they sit on the summits. Far quicker than typing a number.
  headingInput?.addEventListener("input", () => setHeading(Number(headingInput.value)));

  calibrateEl?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!current || heading == null) return;
    if (saveStatusEl) saveStatusEl.textContent = "Saving…";
    try {
      const res = await fetch(`${API.photos}/${encodeURIComponent(current.id)}`, {
        method: "PATCH",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ heading }),
      });
      if (!res.ok) throw new Error((await res.json().catch(() => null))?.error ?? `Failed (${res.status})`);
      current.heading = heading;
      if (saveStatusEl) saveStatusEl.textContent = "Saved";
      setStatus(`${placed.length} summits · north saved`);
    } catch (error) {
      if (saveStatusEl) saveStatusEl.textContent = error instanceof Error ? error.message : "Failed";
    }
  });

  // --- the reel ------------------------------------------------------------

  /*
    Rendering happens here rather than in the viewer for the same reason the
    summit labels do: the clip needs the title, the date and the coordinates,
    and the sphere knows none of them. The top-bar row is the only control.
  */
  type ReelState = "idle" | "working" | "done";

  let reelAvailable = false;
  let reelState: ReelState = "idle";
  let reelProgress = 0;
  let reelJob: AbortController | null = null;

  /** The top-bar row: whether it is offered, and what it is doing. */
  function paintReel() {
    if (reelOpenEl) reelOpenEl.hidden = !reelAvailable;
    if (reelCancelEl) reelCancelEl.hidden = reelState !== "working";
    // No photo yet means no title, no date and no texture to render from — the
    // archive listing can still be in flight, or have failed outright.
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-reel-format]")) {
      button.disabled = reelState === "working" || !current;
    }
  }

  function setReelStatus(message: string) {
    if (reelStatusEl) reelStatusEl.textContent = message;
  }

  function openReelRow(open: boolean) {
    if (!reelFormatsEl || !reelOpenEl) return;
    reelFormatsEl.hidden = !open;
    reelOpenEl.setAttribute("aria-expanded", String(open));
    if (open && reelState === "idle") setReelStatus("15s · saves to your device");
  }

  async function startReel(format: ReelFormat) {
    // The reader can page to the next panorama mid-render; the clip belongs to
    // the one that was on screen when they asked for it.
    const photo = current;
    if (!photo || reelState === "working") return;

    const title = plainTitle(photo);
    const job = new AbortController();
    reelJob = job;
    reelState = "working";
    reelProgress = 0;
    paintReel();
    setReelStatus(`Rendering ${REEL_FORMATS[format].ratio} · 0%`);

    try {
      const blob = await renderReel({
        // The 4K sphere texture, which is already in cache from the viewer —
        // the 8K rung would be a second multi-megabyte download for detail the
        // little planet throws away anyway.
        panorama: `${API.img}/preview/${photo.id}`,
        format,
        caption: {
          title,
          meta: [formatDate(photo), formatCoords(photo)].filter(Boolean).join(" · "),
        },
        site: SITE_NAME,
        signal: job.signal,
        onProgress: (fraction) => {
          const percent = Math.round(fraction * 100);
          if (percent === Math.round(reelProgress * 100)) return;
          reelProgress = fraction;
          paintReel();
          setReelStatus(`Rendering ${REEL_FORMATS[format].ratio} · ${percent}%`);
        },
      });

      setReelStatus(`Saving · ${formatBytes(blob.size)}`);
      await saveReel(blob, reelFilename(title, format), title);
      reelState = "done";
      setReelStatus(`${REEL_FORMATS[format].label} saved · ${formatBytes(blob.size)}`);
    } catch (error) {
      reelState = "idle";
      setReelStatus(
        job.signal.aborted ? "Cancelled" : error instanceof Error ? error.message : "Could not make the video",
      );
    } finally {
      if (reelJob === job) reelJob = null;
      reelProgress = 0;
      paintReel();
    }
  }

  reelOpenEl?.addEventListener("click", () => openReelRow(reelFormatsEl?.hidden ?? true));
  reelCancelEl?.addEventListener("click", () => reelJob?.abort());

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-reel-format]")) {
    button.addEventListener("click", () => void startReel(button.dataset.reelFormat as ReelFormat));
  }

  // --- boot -----------------------------------------------------------------

  const id = idFromLocation();

  if (!ID_RE.test(id)) {
    showError("No panorama selected.");
  } else {
    if (!window.location.pathname.startsWith("/p/")) {
      history.replaceState(null, "", `/p/${encodeURIComponent(id)}/${window.location.hash}`);
    }

    // `/p/<id>/` arrives with the poster already set by the Worker. `/view/?id=`
    // does not, so set it here, before the sphere asks for its texture.
    const poster = document.querySelector<HTMLImageElement>("[data-view-poster]");
    if (poster && !poster.getAttribute("src")) poster.src = `${API.img}/thumb/${id}`;

    // Start the sphere immediately — the metadata request can lag behind.
    document.dispatchEvent(
      new CustomEvent("pano:load", { detail: { target: "#stage", src: `${API.img}/preview/${id}` } }),
    );

    void (async () => {
      /*
        A browser without WebCodecs and H.264 cannot produce a file anyone can
        post, so the button never appears rather than appearing and failing.
        Off the critical path deliberately — the sphere must not wait on a codec
        probe, and the answer is only needed once there is a photo to render.
      */
      reelAvailable = await canRenderReel();
      paintReel();
    })();

    void (async () => {
      try {
        const [list] = await Promise.all([fetchPhotos(), checkAdmin()]);
        photos = list;
        const photo = photos.find((p) => p.id === id);
        if (!photo) {
          showError("That panorama is not in the archive.");
          return;
        }
        show(photo);
      } catch {
        // The sphere is already up; a failed metadata fetch is not fatal.
        if (titleEl) titleEl.textContent = "Panorama";
      }
    })();
  }
</script>
