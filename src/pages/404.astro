---
import Layout from "@/layouts/Layout.astro";
import type { WebPage, WithContext } from "schema-dts";

const schema: WithContext<WebPage> = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	name: "Page Not Found",
	description: "The page you're looking for doesn't exist.",
};
---

<Layout
  title="Page Not Found"
  description="The page you're looking for doesn't exist."
  noindex={true}
  schema={schema}
>
  <section class="flex min-h-[60vh] items-center justify-center">
    <div class="px-[var(--spacing-gutter)] text-center">
      <p class="font-mono text-[0.625rem] uppercase tracking-[0.22em] text-brand-primary">404</p>
      <h1 class="mt-2 font-display text-[clamp(2rem,7vw,3.5rem)] font-extrabold leading-[1.02] tracking-[-0.03em]">
        Nothing at this heading
      </h1>
      <p class="mx-auto mt-3 max-w-sm text-sm text-muted-foreground">
        That panorama isn't in the archive — or the link lost a character on the way here.
      </p>
      <a
        href="/"
        class="mt-6 inline-flex min-h-11 items-center rounded-md bg-primary px-5 font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-primary-foreground transition-transform active:scale-[0.98]"
      >
        Back to the gallery
      </a>
    </div>
  </section>
</Layout>
